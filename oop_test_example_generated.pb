Procedure Human_Init(*This.Human_Inst, Name.s, Age.i)
  Protected *This_vt.Human_vt = *This
      *This\Name = Name
      *This\Age  = Age
EndProcedure

Procedure Human_SayHello(*This.Human_Inst)
  Protected *This_vt.Human_vt = *This
      MessageRequester("Human", "Hello, my name is " + *This\Name + " and I am " + Str(*This\Age) + " years old.")
EndProcedure

Procedure Human_Free(*This.Human_Inst)
  Protected *This_vt.Human_vt = *This
