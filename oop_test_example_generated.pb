Procedure Developer_SayHello(*This.Developer_Inst)
  Protected *This_vt.Developer_vt = *This
      MessageRequester("Developer", "Hello world! I am " + *This\Name + ", coding with " + *This\FavoriteLanguage + "!")
EndProcedure

