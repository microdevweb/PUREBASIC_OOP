Class Chien
  Private nom.s
  Private age.i
  
  Public Method Init(nom_p.s, age_p.i)
  Public Method Aboyer()
  Public Method Free()
EndClass

Method Chien::Init(nom_p.s, age_p.i)
  This\nom = nom_p
  This\age = age_p
EndMethod

Method Chien::Aboyer()
  PrintN(This\nom + " dit : Wouaf ! Wouaf ! (Age : " + Str(This\age) + " ans)")
EndMethod
