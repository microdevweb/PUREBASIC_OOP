XIncludeFile "controls/CheckBox.pbo"
XIncludeFile "controls/ProgressBar.pbo"
XIncludeFile "controls/Slider.pbo"
XIncludeFile "controls/ComboBox.pbo"

; Custom Controls
XIncludeFile "controls/ToggleSwitch.pbo"
