; ============================================================================
; Test PureBasic OOP : Classes Abstraites, Methodes Abstraites & Polymorphisme
; Fichier source : test_abstract_classes.pbo
; ============================================================================

; ----------------------------------------------------------------------------
; 1. CLASSE ABSTRAITE : FormeGeometrique
; ----------------------------------------------------------------------------
Abstract Class FormeGeometrique
  Protected nom.s
  Protected couleur.s

  Public Method Init(nom_p.s, couleur_p.s)

  ; Methodes Abstraites (Contrats purs sans corps)
  Public Abstract Method.d CalculerAire()
  Public Abstract Method.d CalculerPerimetre()
  Public Abstract Method Dessiner()

  ; Methode Concrete / Par Defaut dans la classe abstraite (Template Method)
  Public Method AfficherInfos()
  
  Public Method Free()
EndClass

Method FormeGeometrique::Init(nom_p.s, couleur_p.s)
  This\nom = nom_p
  This\couleur = couleur_p
EndMethod

; Implementation de la methode par defaut dans la classe abstraite
Method FormeGeometrique::AfficherInfos()
  PrintN("[Forme: " + This\nom + " | Couleur: " + This\couleur + "]")
EndMethod

Method FormeGeometrique::Free()
  PrintN("[FormeGeometrique::Free] Liberation de la forme : " + This\nom)
  FreeStructure(This)
EndMethod

; ----------------------------------------------------------------------------
; 2. CLASSE DERIVEE CONCRETE : Rectangle (Herite de FormeGeometrique)
; ----------------------------------------------------------------------------
Class Rectangle Extends FormeGeometrique
  Protected largeur.d
  Protected hauteur.d

  Public Method Init(nom_p.s, couleur_p.s, l.d, h.d)
  
  ; Implementation obligatoire des methodes abstraites
  Public Method.d CalculerAire()
  Public Method.d CalculerPerimetre()
  Public Method Dessiner()
  
  ; Surcharge partielle de la methode par defaut (utilise Super::)
  Public Method AfficherInfos()
  
  Public Method Free()
EndClass

Method Rectangle::Init(nom_p.s, couleur_p.s, l.d, h.d)
  Super::Init(nom_p, couleur_p)
  This\largeur = l
  This\hauteur = h
EndMethod

Method.d Rectangle::CalculerAire()
  ProcedureReturn This\largeur * This\hauteur
EndMethod

Method.d Rectangle::CalculerPerimetre()
  ProcedureReturn 2 * (This\largeur + This\hauteur)
EndMethod

Method Rectangle::Dessiner()
  PrintN("   ==> [DESSIN] Rectangle (" + StrD(This\largeur, 2) + " x " + StrD(This\hauteur, 2) + ") en " + This\couleur)
EndMethod

; Surcharge Partielle : appel du parent Super::AfficherInfos() puis ajout de details
Method Rectangle::AfficherInfos()
  Super::AfficherInfos()
  PrintN("       Details : Largeur=" + StrD(This\largeur, 2) + ", Hauteur=" + StrD(This\hauteur, 2) + " -> Aire=" + StrD(This\CalculerAire(), 2))
EndMethod

Method Rectangle::Free()
  PrintN("[Rectangle::Free] Destruction specifique rectangle " + This\nom)
  Super::Free()
EndMethod

; ----------------------------------------------------------------------------
; 3. CLASSE DERIVEE CONCRETE : Cercle (Herite de FormeGeometrique)
; ----------------------------------------------------------------------------
Class Cercle Extends FormeGeometrique
  Protected rayon.d

  Public Method Init(nom_p.s, couleur_p.s, r.d)
  
  ; Implementation obligatoire des methodes abstraites
  Public Method.d CalculerAire()
  Public Method.d CalculerPerimetre()
  Public Method Dessiner()
  
  ; Surcharge totale de AfficherInfos (sans appel Super::)
  Public Method AfficherInfos()
  
  Public Method Free()
EndClass

Method Cercle::Init(nom_p.s, couleur_p.s, r.d)
  Super::Init(nom_p, couleur_p)
  This\rayon = r
EndMethod

Method.d Cercle::CalculerAire()
  ProcedureReturn 3.1415926535 * This\rayon * This\rayon
EndMethod

Method.d Cercle::CalculerPerimetre()
  ProcedureReturn 2 * 3.1415926535 * This\rayon
EndMethod

Method Cercle::Dessiner()
  PrintN("   ==> [DESSIN] Cercle de rayon " + StrD(This\rayon, 2) + " en " + This\couleur)
EndMethod

; Surcharge Totale : remplace completement l'affichage
Method Cercle::AfficherInfos()
  PrintN("[CERCLE SPECIAL " + This\couleur + "] Rayon=" + StrD(This\rayon, 2) + " | Aire=" + StrD(This\CalculerAire(), 2) + " | Perimetre=" + StrD(This\CalculerPerimetre(), 2))
EndMethod

Method Cercle::Free()
  PrintN("[Cercle::Free] Destruction specifique cercle " + This\nom)
  Super::Free()
EndMethod

; ============================================================================
; 4. PROGRAMME PRINCIPAL DE TEST & DEMONSTRATION DU POLYMORPHISME ABSTRAIT
; ============================================================================

OpenConsole()
CompilerIf #PB_Compiler_OS = #PB_OS_Windows
  SetConsoleOutputCP_(65001)
CompilerEndIf

PrintN("=================================================================")
PrintN("  TEST PUREBASIC OOP : CLASSES & METHODES ABSTRAITES            ")
PrintN("=================================================================")
PrintN("")

; A. Instanciations concretes
Define *rect.Rectangle = New Rectangle("MonRectangle", "Bleu", 10.0, 5.0)
Define *cercle.Cercle = New Cercle("MonCercle", "Rouge", 4.0)

PrintN("--- 1. Appels directs sur instances concretes ---")
*rect\AfficherInfos()
*rect\Dessiner()
PrintN("")
*cercle\AfficherInfos()
*cercle\Dessiner()
PrintN("")

; B. Polymorphisme via la classe abstraite FormeGeometrique
PrintN("--- 2. Polymorphisme dynamique via List FormeGeometrique ---")
NewList *formes.FormeGeometrique()

AddElement(*formes()) : *formes() = *rect
AddElement(*formes()) : *formes() = *cercle
AddElement(*formes()) : *formes() = New Rectangle("GrandRectangle", "Vert", 20.0, 15.0)
AddElement(*formes()) : *formes() = New Cercle("PetitCercle", "Jaune", 1.5)

ForEach *formes()
  PrintN("-> Forme [Index " + Str(ListIndex(*formes())) + "] :")
  *formes()\AfficherInfos()
  *formes()\Dessiner()
  PrintN("   Aire calculee      : " + StrD(*formes()\CalculerAire(), 2))
  PrintN("   Perimetre calcule  : " + StrD(*formes()\CalculerPerimetre(), 2))
  PrintN("")
Next

; C. Nettoyage memoire
PrintN("--- 3. Nettoyage memoire polymorphe ---")
ForEach *formes()
  *formes()\Free()
Next
ClearList(*formes())

PrintN("")
PrintN("=================================================================")
PrintN("  TEST CLASSES ABSTRAITES TERMINE AVEC SUCCES                   ")
PrintN("=================================================================")
PrintN("")
PrintN("Appuyez sur Entree pour quitter...")
Input()
CloseConsole()
