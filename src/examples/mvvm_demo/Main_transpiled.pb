Procedure UI_CustomGadget_OnCustomEvent(*This.UI_CustomGadget_Inst, eventType.i)
  Protected *This_vt.UI_CustomGadget_vt = *This
  Select (eventType)
          Case #PB_EventType_MouseEnter:
            *This\isHovered = #True
            *This_vt\OnMouseEnter()
            *This_vt\Redraw()
  
          Case #PB_EventType_MouseLeave:
            *This\isHovered = #False
            *This\isPressed = #False
            *This_vt\OnMouseLeave()
            *This_vt\Redraw()
  
          Case #PB_EventType_LeftButtonDown:
            *This\isPressed = #True
            *This\mouseX = GetGadgetAttribute(*This\id, #PB_Canvas_MouseX)
            *This\mouseY = GetGadgetAttribute(*This\id, #PB_Canvas_MouseY)
            *This_vt\OnMouseDown(*This\mouseX, *This\mouseY, 1)
            *This_vt\Redraw()
  
          Case #PB_EventType_LeftButtonUp:
            Protected wasPressed.b = *This\isPressed
            *This\isPressed = #False
            *This\mouseX = GetGadgetAttribute(*This\id, #PB_Canvas_MouseX)
            *This\mouseY = GetGadgetAttribute(*This\id, #PB_Canvas_MouseY)
            *This_vt\OnMouseUp(*This\mouseX, *This\mouseY, 1)
  If (wasPressed)
              *This_vt\OnClick()
  EndIf
            *This_vt\Redraw()
  
          Case #PB_EventType_MouseMove:
            *This\mouseX = GetGadgetAttribute(*This\id, #PB_Canvas_MouseX)
            *This\mouseY = GetGadgetAttribute(*This\id, #PB_Canvas_MouseY)
            *This_vt\OnMouseMove(*This\mouseX, *This\mouseY)
            *This_vt\Redraw()
  
          Case #PB_EventType_KeyDown:
            *This_vt\OnKeyDown(GetGadgetAttribute(*This\id, #PB_Canvas_Key))
            *This_vt\Redraw()
  EndSelect
EndProcedure

Procedure UI_CustomGadget_Free(*This.UI_CustomGadget_Inst)
  Protected *This_vt.UI_CustomGadget_vt = *This
  If (*This\id)
          UI_UnregisterGadget(*This\id)
          UI_Gadget_Free(*This)
  EndIf
EndProcedure

Procedure UI_MVVM_ObservableObject_Init(*This.UI_MVVM_ObservableObject_Inst)
  Protected *This_vt.UI_MVVM_ObservableObject_vt = *This
EndProcedure

Procedure UI_MVVM_ObservableObject_Free(*This.UI_MVVM_ObservableObject_Inst)
  Protected *This_vt.UI_MVVM_ObservableObject_vt = *This
        ClearMap(*This\propStrings())
        ClearMap(*This\propInts())
        ClearMap(*This\propBools())
        ClearMap(*This\propFloats())
        ClearList(*This\observers())
EndProcedure

Procedure UI_MVVM_ObservableObject_RegisterObserver(*This.UI_MVVM_ObservableObject_Inst, *observer, *cb)
  Protected *This_vt.UI_MVVM_ObservableObject_vt = *This
        If *observer And *cb
          ; Check if already registered
          ForEach *This\observers()
            If *This\observers()\observer = *observer
              *This\observers()\callback = *cb
              ProcedureReturn
            EndIf
          Next
  
          AddElement(*This\observers())
          *This\observers()\observer = *observer
          *This\observers()\callback = *cb
        EndIf
EndProcedure

Procedure UI_MVVM_ObservableObject_UnregisterObserver(*This.UI_MVVM_ObservableObject_Inst, *observer)
  Protected *This_vt.UI_MVVM_ObservableObject_vt = *This
        If *observer
          ForEach *This\observers()
            If *This\observers()\observer = *observer
              DeleteElement(*This\observers())
              Break
            EndIf
          Next
        EndIf
EndProcedure

Procedure UI_MVVM_ObservableObject_NotifyPropertyChanged(*This.UI_MVVM_ObservableObject_Inst, propName.s)
  Protected *This_vt.UI_MVVM_ObservableObject_vt = *This
        Protected pKey.s = LCase(propName)
        ForEach *This\observers()
          If *This\observers()\callback
            CallFunctionFast(*This\observers()\callback, *This, @pKey)
          EndIf
        Next
EndProcedure

Procedure.s UI_MVVM_ObservableObject_Get(*This.UI_MVVM_ObservableObject_Inst, propName.s)
  Protected *This_vt.UI_MVVM_ObservableObject_vt = *This
        ProcedureReturn *This_vt\GetValueAsString(propName)
EndProcedure

Procedure.b UI_MVVM_ObservableObject_Set_s_s(*This.UI_MVVM_ObservableObject_Inst, propName.s, val.s)
  Protected *This_vt.UI_MVVM_ObservableObject_vt = *This
        ProcedureReturn *This_vt\SetString(propName, val)
EndProcedure

Procedure.b UI_MVVM_ObservableObject_Set_s_i(*This.UI_MVVM_ObservableObject_Inst, propName.s, val.i)
  Protected *This_vt.UI_MVVM_ObservableObject_vt = *This
        ProcedureReturn *This_vt\SetInt(propName, val)
EndProcedure

Procedure.b UI_MVVM_ObservableObject_Set_s_b(*This.UI_MVVM_ObservableObject_Inst, propName.s, val.b)
  Protected *This_vt.UI_MVVM_ObservableObject_vt = *This
        ProcedureReturn *This_vt\SetBool(propName, val)
EndProcedure

Procedure.b UI_MVVM_ObservableObject_Set_s_d(*This.UI_MVVM_ObservableObject_Inst, propName.s, val.d)
  Protected *This_vt.UI_MVVM_ObservableObject_vt = *This
        ProcedureReturn *This_vt\SetDouble(propName, val)
EndProcedure

Procedure.s UI_MVVM_ObservableObject_GetString(*This.UI_MVVM_ObservableObject_Inst, propName.s)
  Protected *This_vt.UI_MVVM_ObservableObject_vt = *This
        Protected pKey.s = LCase(propName)
        If FindMapElement(*This\propStrings(), pKey)
          ProcedureReturn *This\propStrings()
        EndIf
        ProcedureReturn ""
EndProcedure

Procedure.b UI_MVVM_ObservableObject_SetString(*This.UI_MVVM_ObservableObject_Inst, propName.s, val.s)
  Protected *This_vt.UI_MVVM_ObservableObject_vt = *This
        Protected pKey.s = LCase(propName)
        If FindMapElement(*This\propStrings(), pKey)
          If *This\propStrings() = val
            ProcedureReturn #False ; No change
          EndIf
        EndIf
        *This\propStrings(pKey) = val
        *This_vt\NotifyPropertyChanged(propName)
        ProcedureReturn #True
EndProcedure

Procedure.i UI_MVVM_ObservableObject_GetInt(*This.UI_MVVM_ObservableObject_Inst, propName.s)
  Protected *This_vt.UI_MVVM_ObservableObject_vt = *This
        Protected pKey.s = LCase(propName)
        If FindMapElement(*This\propInts(), pKey)
          ProcedureReturn *This\propInts()
        EndIf
        ProcedureReturn 0
EndProcedure

Procedure.b UI_MVVM_ObservableObject_SetInt(*This.UI_MVVM_ObservableObject_Inst, propName.s, val.i)
  Protected *This_vt.UI_MVVM_ObservableObject_vt = *This
        Protected pKey.s = LCase(propName)
        If FindMapElement(*This\propInts(), pKey)
          If *This\propInts() = val
            ProcedureReturn #False ; No change
          EndIf
        EndIf
        *This\propInts(pKey) = val
        *This_vt\NotifyPropertyChanged(propName)
        ProcedureReturn #True
EndProcedure

Procedure.b UI_MVVM_ObservableObject_GetBool(*This.UI_MVVM_ObservableObject_Inst, propName.s)
  Protected *This_vt.UI_MVVM_ObservableObject_vt = *This
        Protected pKey.s = LCase(propName)
        If FindMapElement(*This\propBools(), pKey)
          ProcedureReturn *This\propBools()
        EndIf
        ProcedureReturn #False
EndProcedure

Procedure.b UI_MVVM_ObservableObject_SetBool(*This.UI_MVVM_ObservableObject_Inst, propName.s, val.b)
  Protected *This_vt.UI_MVVM_ObservableObject_vt = *This
        Protected pKey.s = LCase(propName)
        If FindMapElement(*This\propBools(), pKey)
          If *This\propBools() = val
            ProcedureReturn #False ; No change
          EndIf
        EndIf
        *This\propBools(pKey) = val
        *This_vt\NotifyPropertyChanged(propName)
        ProcedureReturn #True
EndProcedure

Procedure.d UI_MVVM_ObservableObject_GetDouble(*This.UI_MVVM_ObservableObject_Inst, propName.s)
  Protected *This_vt.UI_MVVM_ObservableObject_vt = *This
        Protected pKey.s = LCase(propName)
        If FindMapElement(*This\propFloats(), pKey)
          ProcedureReturn *This\propFloats()
        EndIf
        ProcedureReturn 0.0
EndProcedure

Procedure.b UI_MVVM_ObservableObject_SetDouble(*This.UI_MVVM_ObservableObject_Inst, propName.s, val.d)
  Protected *This_vt.UI_MVVM_ObservableObject_vt = *This
        Protected pKey.s = LCase(propName)
        If FindMapElement(*This\propFloats(), pKey)
          If *This\propFloats() = val
            ProcedureReturn #False ; No change
          EndIf
        EndIf
        *This\propFloats(pKey) = val
        *This_vt\NotifyPropertyChanged(propName)
        ProcedureReturn #True
EndProcedure

Procedure.s UI_MVVM_ObservableObject_GetValueAsString(*This.UI_MVVM_ObservableObject_Inst, propName.s)
  Protected *This_vt.UI_MVVM_ObservableObject_vt = *This
        Protected pKey.s = LCase(propName)
        If FindMapElement(*This\propStrings(), pKey)
          ProcedureReturn *This\propStrings()
        ElseIf FindMapElement(*This\propInts(), pKey)
          ProcedureReturn Str(*This\propInts())
        ElseIf FindMapElement(*This\propBools(), pKey)
          If *This\propBools()
            ProcedureReturn "true"
          Else
            ProcedureReturn "false"
          EndIf
        ElseIf FindMapElement(*This\propFloats(), pKey)
          ProcedureReturn StrD(*This\propFloats())
        EndIf
        ProcedureReturn ""
EndProcedure

Procedure UI_MVVM_ObservableObject_SetValueFromString(*This.UI_MVVM_ObservableObject_Inst, propName.s, valStr.s)
  Protected *This_vt.UI_MVVM_ObservableObject_vt = *This
        Protected pKey.s = LCase(propName)
        If FindMapElement(*This\propInts(), pKey)
          *This_vt\SetInt(propName, Val(valStr))
        ElseIf FindMapElement(*This\propBools(), pKey)
          Protected bVal.b = #False
          Protected uStr.s = UCase(Trim(valStr))
          If uStr = "TRUE" Or uStr = "1" : bVal = #True : EndIf
          *This_vt\SetBool(propName, bVal)
        ElseIf FindMapElement(*This\propFloats(), pKey)
          *This_vt\SetDouble(propName, ValD(valStr))
        Else
          *This_vt\SetString(propName, valStr)
        EndIf
EndProcedure

Procedure UI_MVVM_RelayCommand_Init_p(*This.UI_MVVM_RelayCommand_Inst, *action)
  Protected *This_vt.UI_MVVM_RelayCommand_vt = *This
        *This\actionProc = *action
        *This\canExecuteProc = 0
EndProcedure

Procedure UI_MVVM_RelayCommand_Init_p_p(*This.UI_MVVM_RelayCommand_Inst, *action, *canExec)
  Protected *This_vt.UI_MVVM_RelayCommand_vt = *This
        *This\actionProc = *action
        *This\canExecuteProc = *canExec
EndProcedure

Procedure UI_MVVM_RelayCommand_Free(*This.UI_MVVM_RelayCommand_Inst)
  Protected *This_vt.UI_MVVM_RelayCommand_vt = *This
        *This\actionProc = 0
        *This\canExecuteProc = 0
EndProcedure

Procedure.b UI_MVVM_RelayCommand_CanExecute(*This.UI_MVVM_RelayCommand_Inst, *param)
  Protected *This_vt.UI_MVVM_RelayCommand_vt = *This
        If *This\canExecuteProc
          ProcedureReturn CallFunctionFast(*This\canExecuteProc, *param)
        EndIf
        ProcedureReturn #True
EndProcedure

Procedure UI_MVVM_RelayCommand_Execute(*This.UI_MVVM_RelayCommand_Inst, *param)
  Protected *This_vt.UI_MVVM_RelayCommand_vt = *This
        If *This_vt\CanExecute(*param)
          If *This\actionProc
            CallFunctionFast(*This\actionProc, *param)
          EndIf
        EndIf
EndProcedure

Procedure UI_MVVM_ViewModelBase_Init(*This.UI_MVVM_ViewModelBase_Inst)
  Protected *This_vt.UI_MVVM_ViewModelBase_vt = *This
        UI_MVVM_ObservableObject_Init(*This)
EndProcedure

Procedure UI_MVVM_ViewModelBase_Free(*This.UI_MVVM_ViewModelBase_Inst)
  Protected *This_vt.UI_MVVM_ViewModelBase_vt = *This
        ForEach *This\commands()
          If *This\commands()
            *This\commands()\Free()
          EndIf
        Next
        ClearMap(*This\commands())
        UI_MVVM_ObservableObject_Free(*This)
EndProcedure

Procedure UI_MVVM_ViewModelBase_RegisterCommand(*This.UI_MVVM_ViewModelBase_Inst, name_p.s, *cmd.UI_MVVM_RelayCommand_vt)
  Protected *This_vt.UI_MVVM_ViewModelBase_vt = *This
        If name_p <> "" And *cmd
          *This\commands(LCase(name_p)) = *cmd
        EndIf
EndProcedure

Procedure.i UI_MVVM_ViewModelBase_GetCommand(*This.UI_MVVM_ViewModelBase_Inst, name_p.s)
  Protected *This_vt.UI_MVVM_ViewModelBase_vt = *This
        Protected cKey.s = LCase(name_p)
        If FindMapElement(*This\commands(), cKey)
          ProcedureReturn *This\commands()
        EndIf
        ProcedureReturn 0
EndProcedure

Procedure.b UI_MVVM_ViewModelBase_ExecuteCommand(*This.UI_MVVM_ViewModelBase_Inst, name_p.s, *param)
  Protected *This_vt.UI_MVVM_ViewModelBase_vt = *This
        Protected *cmd.UI_MVVM_RelayCommand_vt = *This_vt\GetCommand(name_p)
        If *cmd
          If *cmd\CanExecute(*param)
            *cmd\Execute(*param)
            ProcedureReturn #True
          EndIf
        EndIf
        ; Fallback to virtual OnCommand for zero-boilerplate command handling
        ProcedureReturn *This_vt\OnCommand(name_p, *param)
EndProcedure

Procedure.b UI_MVVM_ViewModelBase_OnCommand(*This.UI_MVVM_ViewModelBase_Inst, name_p.s, *param)
  Protected *This_vt.UI_MVVM_ViewModelBase_vt = *This
        ProcedureReturn #False
EndProcedure

