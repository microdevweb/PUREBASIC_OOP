  If (*This\height > 0)
          ProcedureReturn *This\height
  EndIf
        ProcedureReturn 30
EndProcedure

Procedure UI_Component_Arrange(*This.UI_Component_Inst, nx.i, ny.i, nw.i, nh.i)
  Protected *This_vt.UI_Component_vt = *This
        *This_vt\SetPosition(nx, ny, nw, nh)
  If (*This\id And IsGadget(*This\id))
          ResizeGadget(*This\id, nx, ny, nw, nh)
  EndIf
EndProcedure

Procedure UI_Gadget_Init(*This.UI_Gadget_Inst)
  Protected *This_vt.UI_Gadget_vt = *This
        UI_Component_Init(*This)
EndProcedure

Procedure.s UI_Gadget_GetText(*This.UI_Gadget_Inst)
  Protected *This_vt.UI_Gadget_vt = *This
  If (*This\id And IsGadget(*This\id))
          ProcedureReturn GetGadgetText(*This\id)
  EndIf
        ProcedureReturn ""
EndProcedure

Procedure UI_Gadget_SetText(*This.UI_Gadget_Inst, t.s)
  Protected *This_vt.UI_Gadget_vt = *This
  If (*This\id And IsGadget(*This\id))
          SetGadgetText(*This\id, t)
  EndIf
EndProcedure

Procedure UI_Gadget_SetToolTip(*This.UI_Gadget_Inst, tip.s)
  Protected *This_vt.UI_Gadget_vt = *This
        *This\tooltip = tip
  If (*This\id And IsGadget(*This\id))
          GadgetToolTip(*This\id, tip)
  EndIf
EndProcedure

Procedure.s UI_Gadget_GetToolTip(*This.UI_Gadget_Inst)
  Protected *This_vt.UI_Gadget_vt = *This
        ProcedureReturn *This\tooltip
EndProcedure

Procedure UI_Gadget_SetPosition(*This.UI_Gadget_Inst, nx.i, ny.i, nw.i, nh.i)
  Protected *This_vt.UI_Gadget_vt = *This
        If nw < 0 : nw = 0 : EndIf
        If nh < 0 : nh = 0 : EndIf
        *This\x = nx : *This\y = ny : *This\width = nw : *This\height = nh
  If (*This\id And IsGadget(*This\id))
          ResizeGadget(*This\id, nx, ny, nw, nh)
  EndIf
EndProcedure

Procedure UI_Gadget_SetVisible(*This.UI_Gadget_Inst, v.b)
  Protected *This_vt.UI_Gadget_vt = *This
        *This\isVisible = v
  If (*This\id And IsGadget(*This\id))
          HideGadget(*This\id, 1 - v)
  EndIf
EndProcedure

Procedure UI_Gadget_SetEnabled(*This.UI_Gadget_Inst, e.b)
  Protected *This_vt.UI_Gadget_vt = *This
        *This\isEnabled = e
  If (*This\id And IsGadget(*This\id))
          DisableGadget(*This\id, 1 - e)
  EndIf
EndProcedure

Procedure UI_Gadget_SetColor(*This.UI_Gadget_Inst, colorType.i, color.i)
  Protected *This_vt.UI_Gadget_vt = *This
  If (*This\id And IsGadget(*This\id))
          SetGadgetColor(*This\id, colorType, color)
  EndIf
EndProcedure

Procedure.i UI_Gadget_GetColor(*This.UI_Gadget_Inst, colorType.i)
  Protected *This_vt.UI_Gadget_vt = *This
  If (*This\id And IsGadget(*This\id))
          ProcedureReturn GetGadgetColor(*This\id, colorType)
  EndIf
        ProcedureReturn -1
EndProcedure

Procedure UI_Gadget_SetFont(*This.UI_Gadget_Inst, font.i)
  Protected *This_vt.UI_Gadget_vt = *This
        *This\fontID = font
  If (*This\id And IsGadget(*This\id))
          SetGadgetFont(*This\id, font)
  EndIf
EndProcedure

Procedure UI_Gadget_SetFocus(*This.UI_Gadget_Inst)
  Protected *This_vt.UI_Gadget_vt = *This
  If (*This\id And IsGadget(*This\id))
          SetActiveGadget(*This\id)
  EndIf
EndProcedure

Procedure UI_Gadget_Free(*This.UI_Gadget_Inst)
  Protected *This_vt.UI_Gadget_vt = *This
  If (*This\id And IsGadget(*This\id))
          FreeGadget(*This\id)
          *This\id = 0
