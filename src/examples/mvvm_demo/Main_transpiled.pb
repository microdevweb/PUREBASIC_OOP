  Protected *This_vt.UI_ToggleSwitch_vt = *This
        UI_CustomGadget_Init_i_i(*This, 50, 26)
        *This\isChecked = #False
        *This\activeColor = RGB(52, 199, 89)      ; iOS Green
        *This\inactiveColor = RGB(200, 200, 205)  ; Light Gray
        *This_vt\Redraw()
EndProcedure

