Procedure UI_MVVM_ObservableCollection_RegisterCollectionObserver(*This.UI_MVVM_ObservableCollection_Inst, *observer, *cb)
  Protected *This_vt.UI_MVVM_ObservableCollection_vt = *This
        If *observer And *cb
          ForEach *This\colObservers()
