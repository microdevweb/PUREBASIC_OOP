        UI_Layouts_Container_Init_i_i(*This, w_p, h_p)
        *This\orientation = orient
        *This\spacing = sp
EndProcedure

Procedure UI_Layouts_StackPanel_SetOrientation(*This.UI_Layouts_StackPanel_Inst, o.i)
