Procedure.i UI_Component_GetDesiredWidth(*This.UI_Component_Inst)
  Protected *This_vt.UI_Component_vt = *This
  If (*This\desiredWidth > 0)
          ProcedureReturn *This\desiredWidth
  EndIf
  If (*This\width > 0)
          ProcedureReturn *This\width
  EndIf
        ProcedureReturn 100
EndProcedure

