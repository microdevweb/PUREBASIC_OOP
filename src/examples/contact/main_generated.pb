Procedure ContactApp_ContactDialog_Init(*This.ContactApp_ContactDialog_Inst, parentWinId.i, titleText.s)
  Protected *This_vt.ContactApp_ContactDialog_vt = *This
        *This_vt\CreateWindowInternal(titleText, #PB_Ignore, #PB_Ignore, 480, 520, #PB_Window_SystemMenu | #PB_Window_ScreenCentered, parentWinId)
        *This\contactId = 0
        *This\isSaved = #False
  
        ; Main Vertical StackPanel (with 15px margin around the dialog)
        *This\rootPanel = New_UI_Layouts_StackPanel_i_i(#UI_Orientation_Vertical, 10)
        *This\rootPanel\SetMargin(15, 15, 15, 15)
  
        ; Header Title
        *This\headerLabel = New_UI_Label_s(titleText)
        *This\rootPanel\AddChild(*This\headerLabel)
  
        ; Fields
        *This\rootPanel\AddChild(New_UI_Label_s("First Name:"))
        *This\txtFirstName = New_UI_TextBox_s_i_i("", 440, 26)
        *This\rootPanel\AddChild(*This\txtFirstName)
  
        *This\rootPanel\AddChild(New_UI_Label_s("Last Name:"))
        *This\txtLastName = New_UI_TextBox_s_i_i("", 440, 26)
        *This\rootPanel\AddChild(*This\txtLastName)
  
        *This\rootPanel\AddChild(New_UI_Label_s("Email Address:"))
        *This\txtEmail = New_UI_TextBox_s_i_i("", 440, 26)
        *This\rootPanel\AddChild(*This\txtEmail)
  
        *This\rootPanel\AddChild(New_UI_Label_s("Phone Number:"))
        *This\txtPhone = New_UI_TextBox_s_i_i("", 440, 26)
        *This\rootPanel\AddChild(*This\txtPhone)
  
        *This\rootPanel\AddChild(New_UI_Label_s("Company:"))
        *This\txtCompany = New_UI_TextBox_s_i_i("", 440, 26)
        *This\rootPanel\AddChild(*This\txtCompany)
  
        *This\rootPanel\AddChild(New_UI_Label_s("Notes:"))
        *This\txtNotes = New_UI_TextBox_s_i_i("", 440, 26)
        *This\rootPanel\AddChild(*This\txtNotes)
  
        ; Button Bar (Horizontal StackPanel)
        Protected *btnPanel.UI_Layouts_StackPanel_vt = New_UI_Layouts_StackPanel_i_i(#UI_Orientation_Horizontal, 12)
        *btnPanel\SetHorizontalAlignment(#UI_Align_Right)
        *btnPanel\SetMargin(0, 10, 0, 0)
  
        *This\btnCancel = New_UI_Button_s_i_i("Cancel", 100, 32)
        *btnPanel\AddChild(*This\btnCancel)
  
        *This\btnSave = New_UI_Button_s_i_i("Save Contact", 120, 32)
        *btnPanel\AddChild(*This\btnSave)
  
        *This\rootPanel\AddChild(*btnPanel)
  
        *This_vt\SetContent(*This\rootPanel)
        *This_vt\UpdateLayout()
EndProcedure

Procedure ContactApp_ContactDialog_SetContactData(*This.ContactApp_ContactDialog_Inst, id_p.i, fn_p.s, ln_p.s, em_p.s, ph_p.s, co_p.s, nt_p.s)
  Protected *This_vt.ContactApp_ContactDialog_vt = *This
        *This\contactId = id_p
        *This\txtFirstName\SetText(fn_p)
        *This\txtLastName\SetText(ln_p)
        *This\txtEmail\SetText(em_p)
        *This\txtPhone\SetText(ph_p)
        *This\txtCompany\SetText(co_p)
        *This\txtNotes\SetText(nt_p)
  
        If (id_p > 0)
          *This\headerLabel\SetText("Edit Contact #" + Str(id_p))
        Else
          *This\headerLabel\SetText("Add New Contact")
        EndIf
EndProcedure

