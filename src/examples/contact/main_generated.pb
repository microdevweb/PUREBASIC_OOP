Procedure UI_GlobalSizeCallback()
  Protected evWin.i = EventWindow()
  If (FindMapElement(UI_WindowMap(), Str(evWin)))
    Protected *w.UI_Window_vt = UI_WindowMap()
    If (*w)
      *w\OnResize(WindowWidth(evWin), WindowHeight(evWin))
    EndIf
  EndIf
EndProcedure





