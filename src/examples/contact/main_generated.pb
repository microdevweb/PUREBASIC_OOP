Procedure ContactApp_AddContactWindow_Init(*This.ContactApp_AddContactWindow_Inst, parentWinId.i)
  Protected *This_vt.ContactApp_AddContactWindow_vt = *This
        Protected winFlags.i = #PB_Window_SystemMenu | #PB_Window_ScreenCentered | #PB_Window_MinimizeGadget
        *This_vt\CreateWindowInternal("Add New Contact", #PB_Ignore, #PB_Ignore, 460, 520, winFlags, parentWinId)
  
        ; Root vertical panel
        *This\rootPanel = New_UI_Layouts_StackPanel_i_i(#UI_Orientation_Vertical, 8)
