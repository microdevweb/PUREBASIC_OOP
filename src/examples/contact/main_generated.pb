Procedure ContactApp_ContactRepository_Init(*This.ContactApp_ContactRepository_Inst)
  Protected *This_vt.ContactApp_ContactRepository_vt = *This
        *This\dbHandle = 0
        *This\dbFilePath = "contacts.db"
EndProcedure

Procedure.i ContactApp_ContactRepository_GetDbHandle(*This.ContactApp_ContactRepository_Inst)
  Protected *This_vt.ContactApp_ContactRepository_vt = *This
        ProcedureReturn *This\dbHandle
EndProcedure

Procedure.b ContactApp_ContactRepository_OpenDB(*This.ContactApp_ContactRepository_Inst, filePath.s)
  Protected *This_vt.ContactApp_ContactRepository_vt = *This
        *This\dbFilePath = filePath
        UseSQLiteDatabase()
  
        If (FileSize(filePath) <= 0)
          Protected f = CreateFile(#PB_Any, filePath)
          If (f)
            CloseFile(f)
          EndIf
        EndIf
  
        *This\dbHandle = OpenDatabase(#PB_Any, filePath, "", "")
        If (*This\dbHandle)
          *This_vt\CreateSchema()
          ProcedureReturn #True
        EndIf
        ProcedureReturn #False
EndProcedure

Procedure ContactApp_ContactRepository_CreateSchema(*This.ContactApp_ContactRepository_Inst)
  Protected *This_vt.ContactApp_ContactRepository_vt = *This
        If (Not *This\dbHandle) : ProcedureReturn : EndIf
  
        Protected sql.s = "CREATE TABLE IF NOT EXISTS contacts (" +
                          "id INTEGER PRIMARY KEY AUTOINCREMENT, " +
                          "first_name TEXT, " +
                          "last_name TEXT, " +
                          "email TEXT, " +
                          "phone TEXT, " +
                          "company TEXT, " +
                          "notes TEXT" +
                          ");"
        DatabaseUpdate(*This\dbHandle, sql)
EndProcedure

Procedure.i ContactApp_ContactRepository_GetTotalCount(*This.ContactApp_ContactRepository_Inst)
  Protected *This_vt.ContactApp_ContactRepository_vt = *This
        If (Not *This\dbHandle) : ProcedureReturn 0 : EndIf
        Protected count.i = 0
        If (DatabaseQuery(*This\dbHandle, "SELECT COUNT(*) FROM contacts;"))
          If (NextDatabaseRow(*This\dbHandle))
            count = GetDatabaseLong(*This\dbHandle, 0)
          EndIf
          FinishDatabaseQuery(*This\dbHandle)
        EndIf
        ProcedureReturn count
EndProcedure

Procedure.i ContactApp_ContactRepository_Add(*This.ContactApp_ContactRepository_Inst, *c.ContactApp_Contact_vt)
  Protected *This_vt.ContactApp_ContactRepository_vt = *This
        If (Not *This\dbHandle Or Not *c) : ProcedureReturn 0 : EndIf
  
        Protected fn.s = ReplaceString(*c\GetFirstName(), "'", "''")
        Protected ln.s = ReplaceString(*c\GetLastName(), "'", "''")
        Protected em.s = ReplaceString(*c\GetEmail(), "'", "''")
        Protected ph.s = ReplaceString(*c\GetPhone(), "'", "''")
        Protected co.s = ReplaceString(*c\GetCompany(), "'", "''")
        Protected nt.s = ReplaceString(*c\GetNotes(), "'", "''")
  
        Protected sql.s = "INSERT INTO contacts (first_name, last_name, email, phone, company, notes) VALUES (" +
                          "'" + fn + "', " +
                          "'" + ln + "', " +
                          "'" + em + "', " +
                          "'" + ph + "', " +
                          "'" + co + "', " +
                          "'" + nt + "');"
  
        If (DatabaseUpdate(*This\dbHandle, sql))
          If (DatabaseQuery(*This\dbHandle, "SELECT last_insert_rowid();"))
            If (NextDatabaseRow(*This\dbHandle))
              *c\SetId(GetDatabaseLong(*This\dbHandle, 0))
            EndIf
            FinishDatabaseQuery(*This\dbHandle)
          EndIf
          ProcedureReturn *c\GetId()
        EndIf
        ProcedureReturn 0
EndProcedure

Procedure.b ContactApp_ContactRepository_Update(*This.ContactApp_ContactRepository_Inst, *c.ContactApp_Contact_vt)
  Protected *This_vt.ContactApp_ContactRepository_vt = *This
        If (Not *This\dbHandle Or Not *c Or *c\GetId() <= 0) : ProcedureReturn #False : EndIf
  
        Protected fn.s = ReplaceString(*c\GetFirstName(), "'", "''")
        Protected ln.s = ReplaceString(*c\GetLastName(), "'", "''")
        Protected em.s = ReplaceString(*c\GetEmail(), "'", "''")
        Protected ph.s = ReplaceString(*c\GetPhone(), "'", "''")
        Protected co.s = ReplaceString(*c\GetCompany(), "'", "''")
        Protected nt.s = ReplaceString(*c\GetNotes(), "'", "''")
  
        Protected sql.s = "UPDATE contacts SET " +
                          "first_name = '" + fn + "', " +
                          "last_name = '" + ln + "', " +
                          "email = '" + em + "', " +
                          "phone = '" + ph + "', " +
                          "company = '" + co + "', " +
                          "notes = '" + nt + "' " +
                          "WHERE id = " + Str(*c\GetId()) + ";"
  
        ProcedureReturn DatabaseUpdate(*This\dbHandle, sql)
EndProcedure

Procedure.b ContactApp_ContactRepository_Delete(*This.ContactApp_ContactRepository_Inst, id.i)
  Protected *This_vt.ContactApp_ContactRepository_vt = *This
        If (Not *This\dbHandle Or id <= 0) : ProcedureReturn #False : EndIf
        Protected sql.s = "DELETE FROM contacts WHERE id = " + Str(id) + ";"
        ProcedureReturn DatabaseUpdate(*This\dbHandle, sql)
EndProcedure

Procedure.i ContactApp_ContactRepository_GetById(*This.ContactApp_ContactRepository_Inst, id.i)
  Protected *This_vt.ContactApp_ContactRepository_vt = *This
        If (Not *This\dbHandle Or id <= 0) : ProcedureReturn 0 : EndIf
  
        Protected sql.s = "SELECT id, first_name, last_name, email, phone, company, notes FROM contacts WHERE id = " + Str(id) + ";"
        Protected *contact.ContactApp_Contact_vt = 0
  
        If (DatabaseQuery(*This\dbHandle, sql))
          If (NextDatabaseRow(*This\dbHandle))
            *contact = New_ContactApp_Contact_i_s_s_s_s_s_s(GetDatabaseLong(*This\dbHandle, 0), GetDatabaseString(*This\dbHandle, 1), GetDatabaseString(*This\dbHandle, 2), GetDatabaseString(*This\dbHandle, 3), GetDatabaseString(*This\dbHandle, 4), GetDatabaseString(*This\dbHandle, 5), GetDatabaseString(*This\dbHandle, 6))
          EndIf
          FinishDatabaseQuery(*This\dbHandle)
        EndIf
  
        ProcedureReturn *contact
EndProcedure

Procedure ContactApp_ContactRepository_SeedDefaultContacts(*This.ContactApp_ContactRepository_Inst)
  Protected *This_vt.ContactApp_ContactRepository_vt = *This
        If (*This_vt\GetTotalCount() = 0)
          Protected *c1.ContactApp_Contact_vt = New_ContactApp_Contact_i_s_s_s_s_s_s(0, "John", "Doe", "john.doe@example.com", "+1-555-0100", "Acme Corp", "Key client account")
          *This_vt\Add(*c1)
          *c1\Free()
  
          Protected *c2.ContactApp_Contact_vt = New_ContactApp_Contact_i_s_s_s_s_s_s(0, "Alice", "Smith", "alice.smith@techvision.org", "+1-555-0200", "TechVision Inc", "Lead UI Architect")
          *This_vt\Add(*c2)
          *c2\Free()
  
          Protected *c3.ContactApp_Contact_vt = New_ContactApp_Contact_i_s_s_s_s_s_s(0, "Robert", "Johnson", "r.johnson@globalsolutions.com", "+44-20-7946-0912", "Global Solutions", "Project Director")
          *This_vt\Add(*c3)
          *c3\Free()
  
          Protected *c4.ContactApp_Contact_vt = New_ContactApp_Contact_i_s_s_s_s_s_s(0, "Emma", "Watson", "emma.w@creativemedia.io", "+33-1-42-68-55-00", "Creative Media", "Design Consultant")
          *This_vt\Add(*c4)
          *c4\Free()
        EndIf
EndProcedure

