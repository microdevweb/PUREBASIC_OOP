EndProcedure

Procedure UI_Application_SetMainWindow(*This.UI_Application_Inst, *win_p.UI_Window_vt)
  Protected *This_vt.UI_Application_vt = *This
        *This\mainWindow = *win_p
EndProcedure

Procedure.i UI_Application_GetMainWindow(*This.UI_Application_Inst)
  Protected *This_vt.UI_Application_vt = *This
        ProcedureReturn *This\mainWindow
EndProcedure

Procedure UI_Application_Run_void(*This.UI_Application_Inst)
  Protected *This_vt.UI_Application_vt = *This
        *This\isRunning = #True
        Protected ev.i, evGadget.i, evWin.i, evType.i
  
  While (*This\isRunning)
          ev = WaitWindowEvent()
          evWin = EventWindow()
          evType = EventType()
  
  Select (ev)
            Case #PB_Event_Gadget:
              evGadget = EventGadget()
  If (FindMapElement(UI_GadgetMap(), Str(evGadget)))
                Protected *g.UI_Gadget_vt = UI_GadgetMap()
  If (*g)
  Select (evType)
                    Case #PB_EventType_LeftClick:
                      *g\OnClick()
                    Case #PB_EventType_Change:
                      *g\OnChange()
                    Case #PB_EventType_Focus:
                      *g\OnFocus()
                    Case #PB_EventType_LostFocus:
                      *g\OnLostFocus()
                    Case #PB_EventType_RightClick:
                      *g\OnRightClick()
                    Default:
                      *g\OnCustomEvent(evType)
  EndSelect
  EndIf
  EndIf
  
            Case #PB_Event_CloseWindow:
              Protected isMainWin.b = #False
  If (FindMapElement(UI_WindowMap(), Str(evWin)))
                Protected *w.UI_Window_vt = UI_WindowMap()
  If (*w)
                  If (*This\mainWindow And *w = *This\mainWindow)
                    isMainWin = #True
                  EndIf
  If (*w\OnClose())
                    *w\Close()
  If (isMainWin Or MapSize(UI_WindowMap()) = 0)
                      *This_vt\Quit()
  EndIf
  EndIf
  EndIf
  Else
                CloseWindow(evWin)
  If (MapSize(UI_WindowMap()) = 0)
                  *This_vt\Quit()
  EndIf
  EndIf
  
            Case #PB_Event_SizeWindow:
  If (FindMapElement(UI_WindowMap(), Str(evWin)))
                Protected *wSize.UI_Window_vt = UI_WindowMap()
  If (*wSize)
                  *wSize\OnResize(WindowWidth(evWin), WindowHeight(evWin))
  EndIf
  EndIf
  
            Case #PB_Event_MoveWindow:
  If (FindMapElement(UI_WindowMap(), Str(evWin)))
                Protected *wMove.UI_Window_vt = UI_WindowMap()
  If (*wMove)
                  *wMove\OnMove(WindowX(evWin), WindowY(evWin))
  EndIf
  EndIf
  
            Case #PB_Event_MinimizeWindow:
  If (FindMapElement(UI_WindowMap(), Str(evWin)))
                Protected *targetWinMin.UI_Window_vt = UI_WindowMap()
  If (*targetWinMin)
                  *targetWinMin\OnMinimize()
  EndIf
  EndIf
  
            Case #PB_Event_MaximizeWindow:
  If (FindMapElement(UI_WindowMap(), Str(evWin)))
                Protected *targetWinMax.UI_Window_vt = UI_WindowMap()
  If (*targetWinMax)
                  *targetWinMax\OnMaximize()
  EndIf
  EndIf
  
            Case #PB_Event_RestoreWindow:
  If (FindMapElement(UI_WindowMap(), Str(evWin)))
                Protected *targetWinRest.UI_Window_vt = UI_WindowMap()
  If (*targetWinRest)
                  *targetWinRest\OnRestore()
  EndIf
  EndIf
  EndSelect
  Wend
EndProcedure

Procedure UI_Application_Run_p(*This.UI_Application_Inst, *mainWin_p.UI_Window_vt)
  Protected *This_vt.UI_Application_vt = *This
  If (*mainWin_p)
          *This\mainWindow = *mainWin_p
  EndIf
        *This_vt\Run_void()
EndProcedure

