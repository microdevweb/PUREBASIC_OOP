  Protected *This_vt.UI_TextBox_vt = *This
        UI_Gadget_Init(*This)
        *This\x = 0 : *This\y = 0 : *This\width = w_p : *This\height = h_p
        *This\desiredWidth = w_p : *This\desiredHeight = h_p
