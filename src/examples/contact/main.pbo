; ============================================================================
; PureBasic OOP - Contact Manager Application Entry Point
; Multi-Window Management with SQLite Database & Responsive UI
; Author:      MicrodevWeb
; ============================================================================

EnableExplicit

; Include OOP UI Framework and Modules
XIncludeFile "../../ui/UI.pbo"
XIncludeFile "models/Contact.pbo"
XIncludeFile "data/ContactRepository.pbo"
XIncludeFile "views/MainWindow.pbo"
XIncludeFile "views/AddContactWindow.pbo"
XIncludeFile "views/EditContactWindow.pbo"

Global *app.UI::Application
Global *repo.ContactApp::ContactRepository
Global *mainWin.ContactApp::MainWindow
Global *addWin.ContactApp::AddContactWindow = #Null
Global *editWin.ContactApp::EditContactWindow = #Null

; ----------------------------------------------------------------------------
; Helper: Delete Contact
; ----------------------------------------------------------------------------
Procedure DeleteSelectedContact(contactId.i)
  If contactId <= 0
    MessageRequester("Selection Required", "Please select a contact to delete.", #PB_MessageRequester_Warning)
    ProcedureReturn
  EndIf

  Protected res.i = MessageRequester("Confirm Deletion", "Are you sure you want to delete contact #" + Str(contactId) + "?", #PB_MessageRequester_YesNo | #PB_MessageRequester_Warning)
  If res = #PB_MessageRequester_Yes
    If *repo\Delete(contactId)
      MessageRequester("Deleted", "Contact #" + Str(contactId) + " deleted successfully.", #PB_MessageRequester_Info)
      *mainWin\ReloadContacts(*mainWin\GetSearchText())
    Else
      MessageRequester("Error", "Failed to delete contact from database.", #PB_MessageRequester_Error)
    EndIf
  EndIf
EndProcedure

; ----------------------------------------------------------------------------
; Helper: Open Edit Window for Contact ID
; ----------------------------------------------------------------------------
Procedure OpenEditWindow(contactId.i)
  If contactId <= 0
    MessageRequester("Selection Required", "Please select a contact to edit.", #PB_MessageRequester_Warning)
    ProcedureReturn
  EndIf

  Protected *c.ContactApp::Contact = *repo\GetById(contactId)
  If Not *c
    MessageRequester("Error", "Contact not found with ID #" + Str(contactId), #PB_MessageRequester_Error)
    ProcedureReturn
  EndIf

  If *editWin
    *editWin\Close()
    *editWin\Free()
    *editWin = #Null
  EndIf

  *editWin = New ContactApp::EditContactWindow(*mainWin\GetId())
  *editWin\LoadContact(*c)
  *c\Free()
EndProcedure

; ----------------------------------------------------------------------------
; Helper: Open Add Window
; ----------------------------------------------------------------------------
Procedure OpenAddWindow()
  If *addWin
    *addWin\Close()
    *addWin\Free()
    *addWin = #Null
  EndIf

  *addWin = New ContactApp::AddContactWindow(*mainWin\GetId())
EndProcedure

; ----------------------------------------------------------------------------
; Main Procedure
; ----------------------------------------------------------------------------
Procedure Main()
  ; 1. Initialize Application
  *app = New UI::Application()

  ; 2. Initialize Database Repository
  *repo = New ContactApp::ContactRepository()
  If Not *repo\OpenDB("contacts.db")
    MessageRequester("Database Error", "Failed to open SQLite database: contacts.db", #PB_MessageRequester_Error)
    End 1
  EndIf

  ; 3. Seed Default Sample Data if Empty
  *repo\SeedDefaultContacts()

  ; 4. Create Main Window
  *mainWin = New ContactApp::MainWindow(*repo)
  *app\SetMainWindow(*mainWin)

  ; 5. Unified Application Event Loop
  Protected isRunning.b = #True
  While isRunning
    Protected event = WaitWindowEvent()
    Protected eventWin = EventWindow()
    Protected eventGad = EventGadget()
    Protected eventType = EventType()

    Select event
      ; ----------------------------------------------------------------------
      ; Window Close Event
      ; ----------------------------------------------------------------------
      Case #PB_Event_CloseWindow
        If eventWin = *mainWin\GetId()
          ; Closing Main Window closes entire application
          isRunning = #False

        ElseIf *addWin And eventWin = *addWin\GetId()
          ; Closing Add Window
          *addWin\Close()
          *addWin\Free()
          *addWin = #Null

        ElseIf *editWin And eventWin = *editWin\GetId()
          ; Closing Edit Window
          *editWin\Close()
          *editWin\Free()
          *editWin = #Null
        EndIf

      ; ----------------------------------------------------------------------
      ; Window Resize Event
      ; ----------------------------------------------------------------------
      Case #PB_Event_SizeWindow
        If eventWin = *mainWin\GetId()
          *mainWin\UpdateLayout()
        ElseIf *addWin And eventWin = *addWin\GetId()
          *addWin\UpdateLayout()
        ElseIf *editWin And eventWin = *editWin\GetId()
          *editWin\UpdateLayout()
        EndIf

      ; ----------------------------------------------------------------------
      ; Gadget Events
      ; ----------------------------------------------------------------------
      Case #PB_Event_Gadget
        ; --- MAIN WINDOW EVENTS ---
        If eventWin = *mainWin\GetId()
          If *mainWin\IsAddClicked(eventGad)
            OpenAddWindow()

          ElseIf *mainWin\IsEditClicked(eventGad)
            OpenEditWindow(*mainWin\GetSelectedContactId())

          ElseIf *mainWin\IsDeleteClicked(eventGad)
            DeleteSelectedContact(*mainWin\GetSelectedContactId())

          ElseIf *mainWin\IsRefreshClicked(eventGad)
            *mainWin\ReloadContacts(*mainWin\GetSearchText())

          ElseIf *mainWin\IsSearchClicked(eventGad)
            *mainWin\ReloadContacts(*mainWin\GetSearchText())

          ElseIf *mainWin\IsClearClicked(eventGad)
            *mainWin\ClearSearch()

          ElseIf eventGad = *mainWin\GetListGadgetId()
            If eventType = #PB_EventType_LeftDoubleClick
              OpenEditWindow(*mainWin\GetSelectedContactId())
            EndIf
          EndIf

        ; --- ADD WINDOW EVENTS ---
        ElseIf *addWin And eventWin = *addWin\GetId()
          If *addWin\IsSaveClicked(eventGad)
            If *addWin\ValidateInput()
              Protected fn.s = *addWin\GetFirstName()
              Protected ln.s = *addWin\GetLastName()
              Protected em.s = *addWin\GetEmail()
              Protected ph.s = *addWin\GetPhone()
              Protected co.s = *addWin\GetCompany()
              Protected nt.s = *addWin\GetNotes()

              Protected *newContact.ContactApp::Contact = New ContactApp::Contact(0, fn, ln, em, ph, co, nt)
              Protected newId.i = *repo\Add(*newContact)
              *newContact\Free()

              If newId > 0
                MessageRequester("Success", "Contact added successfully (ID #" + Str(newId) + ")!", #PB_MessageRequester_Info)
                *mainWin\ReloadContacts(*mainWin\GetSearchText())
                *addWin\Close()
                *addWin\Free()
                *addWin = #Null
              Else
                MessageRequester("Error", "Failed to insert contact into database.", #PB_MessageRequester_Error)
              EndIf
            EndIf

          ElseIf *addWin\IsCancelClicked(eventGad)
            *addWin\Close()
            *addWin\Free()
            *addWin = #Null
          EndIf

        ; --- EDIT WINDOW EVENTS ---
        ElseIf *editWin And eventWin = *editWin\GetId()
          If *editWin\IsSaveClicked(eventGad)
            If *editWin\ValidateInput()
              Protected editId.i = *editWin\GetContactId()
              Protected *editContact.ContactApp::Contact = *repo\GetById(editId)
              If *editContact
                *editContact\SetFirstName(*editWin\GetFirstName())
                *editContact\SetLastName(*editWin\GetLastName())
                *editContact\SetEmail(*editWin\GetEmail())
                *editContact\SetPhone(*editWin\GetPhone())
                *editContact\SetCompany(*editWin\GetCompany())
                *editContact\SetNotes(*editWin\GetNotes())

                If *repo\Update(*editContact)
                  MessageRequester("Success", "Contact updated successfully!", #PB_MessageRequester_Info)
                  *mainWin\ReloadContacts(*mainWin\GetSearchText())
                  *editWin\Close()
                  *editWin\Free()
                  *editWin = #Null
                Else
                  MessageRequester("Error", "Failed to update contact in database.", #PB_MessageRequester_Error)
                EndIf
                *editContact\Free()
              EndIf
            EndIf

          ElseIf *editWin\IsCancelClicked(eventGad)
            *editWin\Close()
            *editWin\Free()
            *editWin = #Null
          EndIf
        EndIf

    EndSelect
  Wend

  ; 6. Clean Up and Exit
  If *addWin : *addWin\Close() : *addWin\Free() : *addWin = #Null : EndIf
  If *editWin : *editWin\Close() : *editWin\Free() : *editWin = #Null : EndIf
  *mainWin\Free()
  *repo\Free()
  *app\Free()
EndProcedure

Main()
End 0
