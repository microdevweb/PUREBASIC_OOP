Procedure UI_ProgressBar_Init(*This.UI_ProgressBar_Inst, x_p.i, y_p.i, w_p.i, h_p.i, min_p.i, max_p.i, flags_p.i)
  Protected *This_vt.UI_ProgressBar_vt = *This
        *This\x = x_p : *This\y = y_p : *This\width = w_p : *This\height = h_p
        *This\minVal = min_p : *This\maxVal = max_p
        *This\isVisible = #True : *This\isEnabled = #True
        *This\id = ProgressBarGadget(#PB_Any, x_p, y_p, w_p, h_p, min_p, max_p, flags_p)
  If (*This\id)
          UI_RegisterGadget(*This\id, *This)
  EndIf
EndProcedure

Procedure.i UI_ProgressBar_GetValue(*This.UI_ProgressBar_Inst)
  Protected *This_vt.UI_ProgressBar_vt = *This
  If (*This\id And IsGadget(*This\id))
          ProcedureReturn GetGadgetState(*This\id)
  EndIf
        ProcedureReturn 0
EndProcedure

Procedure UI_ProgressBar_SetValue(*This.UI_ProgressBar_Inst, v.i)
  Protected *This_vt.UI_ProgressBar_vt = *This
  If (*This\id And IsGadget(*This\id))
          SetGadgetState(*This\id, v)
  EndIf
EndProcedure

Procedure UI_ProgressBar_Free(*This.UI_ProgressBar_Inst)
  Protected *This_vt.UI_ProgressBar_vt = *This
  If (*This\id)
          UI_UnregisterGadget(*This\id)
          UI_Gadget_Free(*This)
  EndIf
EndProcedure

Procedure UI_Slider_Init(*This.UI_Slider_Inst, x_p.i, y_p.i, w_p.i, h_p.i, min_p.i, max_p.i, flags_p.i)
  Protected *This_vt.UI_Slider_vt = *This
        *This\x = x_p : *This\y = y_p : *This\width = w_p : *This\height = h_p
        *This\minVal = min_p : *This\maxVal = max_p
        *This\isVisible = #True : *This\isEnabled = #True
        *This\id = TrackBarGadget(#PB_Any, x_p, y_p, w_p, h_p, min_p, max_p, flags_p)
  If (*This\id)
          UI_RegisterGadget(*This\id, *This)
  EndIf
EndProcedure

Procedure.i UI_Slider_GetValue(*This.UI_Slider_Inst)
  Protected *This_vt.UI_Slider_vt = *This
  If (*This\id And IsGadget(*This\id))
          ProcedureReturn GetGadgetState(*This\id)
  EndIf
        ProcedureReturn 0
EndProcedure

Procedure UI_Slider_SetValue(*This.UI_Slider_Inst, v.i)
  Protected *This_vt.UI_Slider_vt = *This
  If (*This\id And IsGadget(*This\id))
          SetGadgetState(*This\id, v)
  EndIf
EndProcedure

Procedure UI_Slider_Free(*This.UI_Slider_Inst)
  Protected *This_vt.UI_Slider_vt = *This
  If (*This\id)
          UI_UnregisterGadget(*This\id)
          UI_Gadget_Free(*This)
  EndIf
EndProcedure

Procedure UI_ComboBox_Init(*This.UI_ComboBox_Inst, x_p.i, y_p.i, w_p.i, h_p.i, flags_p.i)
  Protected *This_vt.UI_ComboBox_vt = *This
        *This\x = x_p : *This\y = y_p : *This\width = w_p : *This\height = h_p
        *This\isVisible = #True : *This\isEnabled = #True
        *This\id = ComboBoxGadget(#PB_Any, x_p, y_p, w_p, h_p, flags_p)
  If (*This\id)
          UI_RegisterGadget(*This\id, *This)
  EndIf
EndProcedure

Procedure UI_ComboBox_AddItem(*This.UI_ComboBox_Inst, text.s)
  Protected *This_vt.UI_ComboBox_vt = *This
  If (*This\id And IsGadget(*This\id))
          AddGadgetItem(*This\id, -1, text)
  EndIf
EndProcedure

Procedure.i UI_ComboBox_GetSelectedIndex(*This.UI_ComboBox_Inst)
  Protected *This_vt.UI_ComboBox_vt = *This
  If (*This\id And IsGadget(*This\id))
          ProcedureReturn GetGadgetState(*This\id)
  EndIf
        ProcedureReturn -1
EndProcedure

Procedure UI_ComboBox_SetSelectedIndex(*This.UI_ComboBox_Inst, idx.i)
  Protected *This_vt.UI_ComboBox_vt = *This
  If (*This\id And IsGadget(*This\id))
          SetGadgetState(*This\id, idx)
  EndIf
EndProcedure

Procedure.s UI_ComboBox_GetSelectedItem(*This.UI_ComboBox_Inst)
  Protected *This_vt.UI_ComboBox_vt = *This
        Protected idx.i = *This_vt\GetSelectedIndex()
  If (idx >= 0 And *This\id And IsGadget(*This\id))
          ProcedureReturn GetGadgetItemText(*This\id, idx)
  EndIf
        ProcedureReturn ""
EndProcedure

Procedure UI_ComboBox_Clear(*This.UI_ComboBox_Inst)
  Protected *This_vt.UI_ComboBox_vt = *This
  If (*This\id And IsGadget(*This\id))
          ClearGadgetItems(*This\id)
  EndIf
EndProcedure

Procedure UI_ComboBox_Free(*This.UI_ComboBox_Inst)
  Protected *This_vt.UI_ComboBox_vt = *This
  If (*This\id)
          UI_UnregisterGadget(*This\id)
          UI_Gadget_Free(*This)
  EndIf
EndProcedure

Procedure UI_Controls_ToggleSwitch_Init(*This.UI_Controls_ToggleSwitch_Inst, x_p.i, y_p.i, w_p.i, h_p.i, defaultState_p.b)
  Protected *This_vt.UI_Controls_ToggleSwitch_vt = *This
        UI_CustomGadget_Init(*This, x_p, y_p, w_p, h_p, 0)
        *This\isChecked = defaultState_p
        *This\activeColor = RGB(52, 199, 89)      ; iOS Green
        *This\inactiveColor = RGB(200, 200, 205)  ; Light Gray
        *This_vt\Redraw()
EndProcedure

Procedure.b UI_Controls_ToggleSwitch_IsChecked(*This.UI_Controls_ToggleSwitch_Inst)
  Protected *This_vt.UI_Controls_ToggleSwitch_vt = *This
        ProcedureReturn *This\isChecked
EndProcedure

Procedure UI_Controls_ToggleSwitch_SetChecked(*This.UI_Controls_ToggleSwitch_Inst, state.b)
  Protected *This_vt.UI_Controls_ToggleSwitch_vt = *This
        *This\isChecked = state
        *This_vt\Redraw()
EndProcedure

Procedure UI_Controls_ToggleSwitch_OnClick(*This.UI_Controls_ToggleSwitch_Inst)
  Protected *This_vt.UI_Controls_ToggleSwitch_vt = *This
        *This\isChecked = 1 - *This\isChecked
        *This_vt\Redraw()
        *This_vt\OnChange()
EndProcedure

Procedure UI_Controls_ToggleSwitch_OnPaint(*This.UI_Controls_ToggleSwitch_Inst, w.i, h.i)
  Protected *This_vt.UI_Controls_ToggleSwitch_vt = *This
        ; Background fill
        Box(0, 0, w, h, RGB(245, 245, 247))
  
        ; Main Pill
        Protected pillColor.i = *This\inactiveColor
  If (*This\isChecked)
          pillColor = *This\activeColor
  EndIf
  If (*This\isHovered)
          ; Slightly brighten on hover
          pillColor = RGB(Red(pillColor) + 15, Green(pillColor) + 15, Blue(pillColor) + 15)
  EndIf
  
        Protected radius.i = h / 2
        RoundBox(1, 1, w - 2, h - 2, radius, radius, pillColor)
  
        ; White circular thumb knob
        Protected knobPadding.i = 3
        Protected knobDiameter.i = h - (knobPadding * 2)
        Protected knobRadius.i = knobDiameter / 2
        Protected knobX.i = knobPadding
  If (*This\isChecked)
          knobX = w - knobDiameter - knobPadding
  EndIf
  
        ; Subtle shadow under knob
        Circle(knobX + knobRadius, radius + 1, knobRadius, RGB(180, 180, 180))
        ; Knob circle
        Circle(knobX + knobRadius, radius, knobRadius, RGB(255, 255, 255))
EndProcedure

