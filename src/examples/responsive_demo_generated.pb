; ----------------------------------------------------------------------------
; 5. CONSTRUCTORS & FACTORY FUNCTIONS
; ----------------------------------------------------------------------------

Procedure.i New_UI_Window_s(title_p.s)
  Protected *obj.UI_Window_Inst = AllocateStructure(UI_Window_Inst)
  If *obj
    *obj\VTable = ?UI_Window_VTable_Data
    UI_Window_Init_s(*obj, title_p)
  EndIf
  ProcedureReturn *obj
EndProcedure

Procedure.i New_UI_Window_s_i_i(title_p.s, w_p.i, h_p.i)
  Protected *obj.UI_Window_Inst = AllocateStructure(UI_Window_Inst)
  If *obj
    *obj\VTable = ?UI_Window_VTable_Data
    UI_Window_Init_s_i_i(*obj, title_p, w_p, h_p)
  EndIf
  ProcedureReturn *obj
EndProcedure

Procedure.i New_UI_Window_s_i_i_i(title_p.s, w_p.i, h_p.i, flags_p.i)
  Protected *obj.UI_Window_Inst = AllocateStructure(UI_Window_Inst)
  If *obj
    *obj\VTable = ?UI_Window_VTable_Data
    UI_Window_Init_s_i_i_i(*obj, title_p, w_p, h_p, flags_p)
  EndIf
  ProcedureReturn *obj
EndProcedure

Procedure.i New_UI_Window_s_i_i_i_i(title_p.s, x_p.i, y_p.i, w_p.i, h_p.i)
  Protected *obj.UI_Window_Inst = AllocateStructure(UI_Window_Inst)
  If *obj
    *obj\VTable = ?UI_Window_VTable_Data
    UI_Window_Init_s_i_i_i_i(*obj, title_p, x_p, y_p, w_p, h_p)
  EndIf
  ProcedureReturn *obj
EndProcedure

Procedure.i New_UI_Window_s_i_i_i_i_i_i(title_p.s, x_p.i, y_p.i, w_p.i, h_p.i, flags_p.i, parent_p.i)
  Protected *obj.UI_Window_Inst = AllocateStructure(UI_Window_Inst)
  If *obj
    *obj\VTable = ?UI_Window_VTable_Data
    UI_Window_Init_s_i_i_i_i_i_i(*obj, title_p, x_p, y_p, w_p, h_p, flags_p, parent_p)
  EndIf
  ProcedureReturn *obj
EndProcedure

Procedure Free_UI_Window(*obj.UI_Window_Inst)
  If *obj
    UI_Window_Free(*obj)
    FreeStructure(*obj)
  EndIf
EndProcedure

Procedure.i New_UI_Application_void()
  Protected *obj.UI_Application_Inst = AllocateStructure(UI_Application_Inst)
  If *obj
    *obj\VTable = ?UI_Application_VTable_Data
    UI_Application_Init_void(*obj)
  EndIf
  ProcedureReturn *obj
EndProcedure

Procedure.i New_UI_Application_s(appName_p.s)
  Protected *obj.UI_Application_Inst = AllocateStructure(UI_Application_Inst)
  If *obj
    *obj\VTable = ?UI_Application_VTable_Data
    UI_Application_Init_s(*obj, appName_p)
  EndIf
  ProcedureReturn *obj
EndProcedure

Procedure Free_UI_Application(*obj.UI_Application_Inst)
  If *obj
    FreeStructure(*obj)
  EndIf
EndProcedure

Procedure.i New_UI_Layouts_Container()
  Protected *obj.UI_Layouts_Container_Inst = AllocateStructure(UI_Layouts_Container_Inst)
  If *obj
    *obj\VTable = ?UI_Layouts_Container_VTable_Data
