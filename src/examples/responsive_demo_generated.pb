  Protected *This_vt.UI_Layouts_Container_vt = *This
        *This\paddingLeft = p
        *This\paddingTop = p
        *This\paddingRight = p
        *This\paddingBottom = p
        *This_vt\UpdateLayout()
EndProcedure

