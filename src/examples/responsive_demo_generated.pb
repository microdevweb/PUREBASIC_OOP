        UI_Component_Init(*This)
        *This\paddingLeft = 0
        *This\paddingTop = 0
        *This\paddingRight = 0
        *This\paddingBottom = 0
        *This\horizontalAlignment = #UI_Align_Stretch
        *This\verticalAlignment = #UI_Align_VStretch
EndProcedure

