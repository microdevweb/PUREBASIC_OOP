  Protected *This_vt.UI_Window_vt = *This
        Protected defFlags.i = #PB_Window_SystemMenu | #PB_Window_ScreenCentered | #PB_Window_MinimizeGadget
        *This_vt\CreateWindowInternal(title_p, #PB_Ignore, #PB_Ignore, 800, 600, defFlags, 0)
EndProcedure

