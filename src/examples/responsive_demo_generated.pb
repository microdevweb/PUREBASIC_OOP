; ----------------------------------------------------------------------------
; 6. MAIN PROGRAM EXECUTION
; ----------------------------------------------------------------------------

; ============================================================================
; PureBasic OOP GUI Framework - Responsive Demo Application
; Demonstrates WPF-style automatic responsive layouts (DockPanel, StackPanel, Grid)
; ============================================================================

; ============================================================================
; PureBasic OOP GUI Framework - UI.pbo (Master Header)
; Include this file to access the entire OOP UI subsystem
; ============================================================================

; ============================================================================
; PureBasic OOP GUI Framework - Component.pbo
; Base abstract class for all UI Windows, Gadgets and Layout Containers
; ============================================================================











; ============================================================================
; PureBasic OOP GUI Framework - Gadget.pbo
; Base abstract class for all PureBasic UI Controls and Gadgets
; ============================================================================




; ============================================================================
; PureBasic OOP GUI Framework - Window.pbo
; Window component encapsulating PureBasic Windows with Multi-Constructors
; ============================================================================




; ============================================================================
; PureBasic OOP GUI Framework - Application.pbo
; Application Manager & Central Event Dispatcher
; ============================================================================









; ============================================================================
; PureBasic OOP GUI Framework - CustomGadget.pbo
; Abstract Base Class for Canvas-Based Owner-Drawn Custom Gadgets
; ============================================================================





; Responsive Layouts (WPF-Style)
; ============================================================================
; PureBasic OOP GUI Framework - Container.pbo
; Base class for all layout containers and panels (StackPanel, DockPanel, Grid...)
; ============================================================================




; ============================================================================
; PureBasic OOP GUI Framework - StackPanel.pbo
; Linear layout panel arranging child components sequentially (Vertical or Horizontal)
; ============================================================================




; ============================================================================
; PureBasic OOP GUI Framework - DockPanel.pbo
; Layout panel docking child components along edges (Top, Bottom, Left, Right, Fill)
; ============================================================================




; ============================================================================
; PureBasic OOP GUI Framework - Grid.pbo
; Flexible 2D Grid layout panel with Fixed, Auto, and Proportional (Star *) sizing
; ============================================================================






; Standard Controls
; ============================================================================
; PureBasic OOP GUI Framework - Button.pbo
; Standard Button and ImageButton wrapper with Multi-Constructors
; ============================================================================




; ============================================================================
; PureBasic OOP GUI Framework - TextBox.pbo
; Standard Text Input / StringGadget wrapper with Multi-Constructors
; ============================================================================




; ============================================================================
; PureBasic OOP GUI Framework - Label.pbo
; Standard Text / Label wrapper
; ============================================================================




; ============================================================================
; PureBasic OOP GUI Framework - CheckBox.pbo
; Standard CheckBox wrapper
; ============================================================================




; ============================================================================
; PureBasic OOP GUI Framework - ProgressBar.pbo
; Standard ProgressBar wrapper
; ============================================================================




; ============================================================================
; PureBasic OOP GUI Framework - Slider.pbo
; Standard TrackBar / Slider wrapper
; ============================================================================




; ============================================================================
; PureBasic OOP GUI Framework - ComboBox.pbo
; Standard ComboBox / Dropdown wrapper
; ============================================================================





; Custom Controls
; ============================================================================
; PureBasic OOP GUI Framework - ToggleSwitch.pbo
; Custom iOS-Style Toggle Switch Widget extending UI_CustomGadget
; ============================================================================






EnableExplicit

; 1. Initialisation de l'application
Define *app.UI_Application_vt = New_UI_Application_s("PureBasic OOP Responsive Demo")

; 2. Fenêtre principale
Define *win.UI_Window_vt = New_UI_Window_s_i_i("PureBasic OOP - Démonstration Responsive WPF", 900, 600)

; 3. Conteneur racine : DockPanel
Define *rootDock.UI_Layouts_DockPanel_vt = New_UI_Layouts_DockPanel_b(#True)
*rootDock\SetPaddingAll(5)

; 4. En-tête supérieur (Dock Top)
Define *headerStack.UI_Layouts_StackPanel_vt = New_UI_Layouts_StackPanel_i_i(#UI_Orientation_Horizontal, 8)
*headerStack\SetPadding(5, 5, 5, 5)
*headerStack\SetHeight(45)

Define *btnNew.UI_Button_vt = New_UI_Button_s_i_i("Nouveau", 90, 32)
Define *btnOpen.UI_Button_vt = New_UI_Button_s_i_i("Ouvrir", 90, 32)
Define *btnSave.UI_Button_vt = New_UI_Button_s_i_i("Enregistrer", 100, 32)
*headerStack\AddChild(*btnNew)
*headerStack\AddChild(*btnOpen)
*headerStack\AddChild(*btnSave)

*rootDock\SetDock(*headerStack, #UI_Dock_Top)

; 5. Pied de page / Barre d'état (Dock Bottom)
Define *statusStack.UI_Layouts_StackPanel_vt = New_UI_Layouts_StackPanel_i_i(#UI_Orientation_Horizontal, 10)
*statusStack\SetHeight(30)
Define *lblStatus.UI_Button_vt = New_UI_Button_s_i_i("Statut : Prêt - Redimensionnez la fenêtre pour tester le responsive !", 600, 24)
*statusStack\AddChild(*lblStatus)

*rootDock\SetDock(*statusStack, #UI_Dock_Bottom)

; 6. Menu latéral gauche (Dock Left)
Define *sidebar.UI_Layouts_StackPanel_vt = New_UI_Layouts_StackPanel_i_i(#UI_Orientation_Vertical, 8)
*sidebar\SetWidth(180)
*sidebar\SetPadding(5, 5, 5, 5)

Define *btnNav1.UI_Button_vt = New_UI_Button_s_i_i("Tableau de bord", 170, 32)
Define *btnNav2.UI_Button_vt = New_UI_Button_s_i_i("Projets", 170, 32)
Define *btnNav3.UI_Button_vt = New_UI_Button_s_i_i("Composants", 170, 32)
Define *btnNav4.UI_Button_vt = New_UI_Button_s_i_i("Paramètres", 170, 32)

*sidebar\AddChild(*btnNav1)
*sidebar\AddChild(*btnNav2)
*sidebar\AddChild(*btnNav3)
*sidebar\AddChild(*btnNav4)

*rootDock\SetDock(*sidebar, #UI_Dock_Left)

; 7. Zone centrale : Grille Responsive (Dock Fill)
Define *mainGrid.UI_Layouts_Grid_vt = New_UI_Layouts_Grid()
*mainGrid\SetPaddingAll(5)

; Définition des colonnes : 3* (Zone principale 75%) et 1* (Volet d'inspection 25%)
*mainGrid\AddColumn("3*")
*mainGrid\AddColumn("1*")

; Définition des lignes : Auto en haut (40px) et * en bas (Reste)
*mainGrid\AddRow("40")
*mainGrid\AddRow("*")

; Ligne 0 : Barre de recherche
Define *searchBox.UI_TextBox_vt = New_UI_TextBox_i_i_i_i_s(0, 0, 100, 30, "Rechercher dans les composants...")
*mainGrid\SetCell(*searchBox, 0, 0)

Define *btnFilter.UI_Button_vt = New_UI_Button_s_i_i("Filtrer", 100, 30)
*mainGrid\SetCell(*btnFilter, 0, 1)

; Ligne 1 : Éditeur principal et Panneau d'inspection
Define *mainEditor.UI_TextBox_vt = New_UI_TextBox_i_i_i_i_s(0, 0, 100, 100, "Zone principale de l'éditeur...")
*mainGrid\SetCell(*mainEditor, 1, 0)

Define *propEditor.UI_TextBox_vt = New_UI_TextBox_i_i_i_i_s(0, 0, 100, 100, "Propriétés...")
*mainGrid\SetCell(*propEditor, 1, 1)

*rootDock\SetDock(*mainGrid, #UI_Dock_Fill)

; 8. Attachement du Layout à la Fenêtre
*win\SetContent(*rootDock)

; 9. Exécution de la boucle d'événements
*app\SetMainWindow(*win)
*app\Run_void()
