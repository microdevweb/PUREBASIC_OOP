; ============================================================================
; Title:       ide_keywords.pb
; Description: Native PureBasic keywords and OOP extension keywords for Scintilla
; Author:      MicrodevWeb
; ============================================================================

EnableExplicit

; ----------------------------------------------------------------------------
; Procedure:   IDE_GetPBKeywords
; Purpose:     Returns standard PureBasic keywords in lowercase for Lexer
; Parameters:  None
; Return:      Space-separated keyword string
; ----------------------------------------------------------------------------
Procedure.s IDE_GetPBKeywords()
  Protected kw.s = ""
  kw + "and as break calldebugger case compilerdefault compilercase compilerelse compilerelseif "
  kw + "compilerendif compilererror compilerif compilerselect compilerwarning continue "
  kw + "datasection debug debuglevel declare declarec declarecdll declaredll "
  kw + "default define dim disabledebugger disableasm elif else elseif enabledebugger "
  kw + "enableasm end enddatasection enddeclaremodule endenumeration endif endimport "
  kw + "endinterface endmacro endmodule endprocedure endselect endstructure "
  kw + "enumeration enumerationbinary extends fakeendselect fakeendif for foreach "
  kw + "forever global gosub goto if import importc includebinary includefile "
  kw + "includepath interface macro map match debugger mid module newlist newmap "
  kw + "next not or procedure procedurec procedurecdll proceduredll procedurereturn "
  kw + "protected prototype prototypec reallocate read redim repeat restore "
  kw + "return runtime select shared static step structure structureunion "
  kw + "swap threaded to until until_debug unusemodule usemodule wend while with xor"
  ProcedureReturn kw
EndProcedure

; ----------------------------------------------------------------------------
; Procedure:   IDE_GetOOPKeywords
; Purpose:     Returns extended OOP keywords in lowercase for Lexer
; Parameters:  None
; Return:      Space-separated keyword string
; ----------------------------------------------------------------------------
Procedure.s IDE_GetOOPKeywords()
  Protected kw.s = ""
  kw + "class endclass method endmethod super this new init free "
  kw + "public protected private override constructor destructor"
  ProcedureReturn kw
EndProcedure

; ----------------------------------------------------------------------------
; Procedure:   IDE_GetPBFallbackFunctions
; Purpose:     Returns standard PureBasic built-in functions
; Parameters:  None
; Return:      Space-separated function names string
; ----------------------------------------------------------------------------
Procedure.s IDE_GetPBFallbackFunctions()
  Protected fn.s = ""
  fn + "openwindow closewindow messagerequester stringgadget buttongadget textgadget "
  fn + "listviewgadget canvasgadget createwindow showwindow waitwindowevent windowevent "
  fn + "eventgadget eventwindow eventtype eventmenu eventtimer postevent addelement "
  fn + "cleallist clearmap insertelement deleteelement selectelement firstelement "
  fn + "lastelement previouselement nextelement listsize listindex countlist "
  fn + "asc chr hex val valf str strf formatdate elapsedmilliseconds delay "
  fn + "len left right mid trim ltrim rtrim ucase lcase findstring replacestring "
  fn + "readfile writefile openfile closefile readstring writestring eof loc lof "
  fn + "runprogram killprogram programrunning waitprogram readprogramstring"
  ProcedureReturn fn
EndProcedure

