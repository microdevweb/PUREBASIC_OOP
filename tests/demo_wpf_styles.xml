<Window Title="PureBasic OOP Studio - WPF Styles &amp; 60 FPS Micro-Animations" Width="860" Height="720" Background="#0F172A">
  <Window.Resources>
    <!-- 1. Style Implicite par défaut pour TOUS les CanvasButton -->
    <Style TargetType="CanvasButton">
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontName" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontBold" Value="True"/>
      <Setter Property="Background" Value="#1E293B"/>
      <Setter Property="Foreground" Value="#F8FAFC"/>
      <Setter Property="BorderColor" Value="#334155"/>
      
      <!-- Micro-animations interactives déclenchées par Triggers d'état -->
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#334155"/>
        <Setter Property="BorderColor" Value="#475569"/>
        <Setter Property="Scale" Value="1.05"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="#0F172A"/>
        <Setter Property="Scale" Value="0.96"/>
      </Trigger>
    </Style>

    <!-- 2. Style Nommé : Bouton Principal Indigo (WPF x:Key) -->
    <Style x:Key="PrimaryButton" TargetType="CanvasButton">
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="#4F46E5"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderColor" Value="#4338CA"/>
      
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#6366F1"/>
        <Setter Property="BorderColor" Value="#818CF8"/>
        <Setter Property="Scale" Value="1.05"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="#3730A3"/>
        <Setter Property="Scale" Value="0.96"/>
      </Trigger>
    </Style>

    <!-- 3. Style Nommé : Bouton de Succès Vert Émeraude -->
    <Style x:Key="SuccessButton" TargetType="CanvasButton">
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="#10B981"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderColor" Value="#059669"/>
      
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#34D399"/>
        <Setter Property="BorderColor" Value="#6EE7B7"/>
        <Setter Property="Scale" Value="1.05"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="#047857"/>
        <Setter Property="Scale" Value="0.96"/>
      </Trigger>
    </Style>

    <!-- 4. Style Nommé avec Héritage (BasedOn) : Pilule Rose Cyan -->
    <Style x:Key="PillPinkButton" TargetType="CanvasButton" BasedOn="PrimaryButton">
      <Setter Property="CornerRadius" Value="20"/>
      <Setter Property="Background" Value="#EC4899"/>
      <Setter Property="BorderColor" Value="#DB2777"/>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#F472B6"/>
        <Setter Property="Scale" Value="1.06"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="#BE185D"/>
        <Setter Property="Scale" Value="0.95"/>
      </Trigger>
    </Style>

    <!-- 5. Style Implicite pour tous les CanvasTextBox -->
    <Style TargetType="CanvasTextBox">
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="#1E293B"/>
      <Setter Property="Foreground" Value="#F8FAFC"/>
      <Setter Property="BorderColor" Value="#334155"/>
      <Setter Property="FontName" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="10"/>
    </Style>
  </Window.Resources>

  <StackPanel Orientation="Vertical" Margin="28">

    <!-- En-tête Header Dark Glass Moderne -->
    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
      <StackPanel Orientation="Vertical" Width="620">
        <CanvasText Text="PureBasic Studio - Styles Déclaratifs &amp; Moteur d'Animations" 
                    FontName="Segoe UI" FontSize="16" FontBold="True" 
                    Foreground="#F8FAFC" Height="32" HAlign="Left" />
        <CanvasText Text="Architecture WPF avec Styles implicites, Styles nommés (x:Key), Triggers d'états réactifs et interpolation 60 FPS." 
                    FontName="Segoe UI" FontSize="10" 
                    Foreground="#94A3B8" Height="22" HAlign="Left" />
      </StackPanel>

      <!-- Badge Pill WPF -->
      <CanvasText Text="● WPF Styles v2.0" Width="140" Height="28" Margin="20,2,0,0"
                  FontName="Segoe UI" FontSize="9" FontBold="True"
                  Background="#1E3A5F" Foreground="#38BDF8" 
                  BorderColor="#0284C7" BorderThickness="1" CornerRadius="14" 
                  HAlign="Center" Transparent="False" />
    </StackPanel>

    <!-- Carte informative avec bordure lumineuse subtile -->
    <CanvasText Text="✨ Les styles sont définis dans &lt;Window.Resources&gt;. Les contrôles s'adaptent instantanément avec zoom et transitions d'état réversibles !" 
                Height="40" Margin="0,0,0,24"
                FontName="Segoe UI" FontSize="9"
                Background="#1E293B" Foreground="#93C5FD" 
                BorderColor="#3B82F6" BorderThickness="1" CornerRadius="8" 
                Padding="16,0,16,0" HAlign="Left" Transparent="False" />

    <!-- SECTION 1 : Styles Nommés (x:Key) & Triggers -->
    <CanvasText Text="1. Styles Nommés Spécialisés (&lt;Style x:Key=&quot;...&quot;&gt;)" 
                FontName="Segoe UI" FontSize="11" FontBold="True" 
                Foreground="#E2E8F0" Height="24" Margin="0,0,0,10" HAlign="Left" />

    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
      <CanvasButton Style="PrimaryButton" Text="Action Primaire" Width="160" Height="40" Margin="0,0,14,0" />
      <CanvasButton Style="SuccessButton" Text="Sauvegarder Projet" Width="170" Height="40" Margin="0,0,14,0" />
      <CanvasButton Style="PillPinkButton" Text="Pilule Héréditaire" Width="160" Height="40" Margin="0,0,14,0" />
      <CanvasButton Text="Style Implicite Auto" Width="170" Height="40" />
    </StackPanel>

    <!-- SECTION 2 : Formulaire avec Styles de Saisie Intégrés -->
    <CanvasText Text="2. Saisie Vectorielle &amp; Styles Implicites de Champs" 
                FontName="Segoe UI" FontSize="11" FontBold="True" 
                Foreground="#E2E8F0" Height="24" Margin="0,0,0,10" HAlign="Left" />

    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
      <StackPanel Orientation="Vertical" Width="360" Margin="0,0,16,0">
        <CanvasText Text="Nom de la ressource ou token :" Height="20" Margin="0,0,0,4"
                    FontName="Segoe UI" FontSize="9" FontBold="True" Foreground="#94A3B8" HAlign="Left" />
        <CanvasTextBox Name="txtToken" Text="WpfResourceDictionary" Height="38"
                       Placeholder="Entrez une clé de ressource"
                       ActiveBorderColor="#6366F1" />
      </StackPanel>

      <StackPanel Orientation="Vertical" Width="240" Margin="0,0,16,0">
        <CanvasText Text="Type cible (TargetType) :" Height="20" Margin="0,0,0,4"
                    FontName="Segoe UI" FontSize="9" FontBold="True" Foreground="#94A3B8" HAlign="Left" />
        <CanvasTextBox Name="txtType" Text="CanvasButton" Height="38"
                       ActiveBorderColor="#6366F1" />
      </StackPanel>

      <CanvasButton Style="PrimaryButton" Text="Appliquer" Width="140" Height="38" Margin="0,24,0,0" />
    </StackPanel>

    <!-- SECTION 3 : Surcharge Locale de Propriétés de Style -->
    <CanvasText Text="3. Surcharge Locale de Propriétés (Spécificité et Cascade WPF)" 
                FontName="Segoe UI" FontSize="11" FontBold="True" 
                Foreground="#E2E8F0" Height="24" Margin="0,0,0,10" HAlign="Left" />

    <StackPanel Orientation="Horizontal" Margin="0,0,0,28">
      <!-- Utilise le style PrimaryButton mais surcharge le CornerRadius à 2px (carré) -->
      <CanvasButton Style="PrimaryButton" CornerRadius="2" Text="Carré Sharp" Width="140" Height="38" Margin="0,0,14,0" />
      
      <!-- Utilise le style SuccessButton mais surcharge la couleur de fond locale -->
      <CanvasButton Style="SuccessButton" Background="#0284C7" HoverBackground="#0EA5E9" Text="Bleu Océan" Width="140" Height="38" Margin="0,0,14,0" />

      <!-- Bouton neutre avec micro-zoom 60 FPS activé localement -->
      <CanvasButton Text="Neutre Micro-Zoom" AnimateHoverScale="True" Width="170" Height="38" Margin="0,0,14,0" />
      
      <CanvasButton Style="PillPinkButton" Text="Arrondi Max" Width="140" Height="38" />
    </StackPanel>

    <!-- Footer Card -->
    <CanvasText Text="PureBasic OOP Framework • Rendu VectorDrawing • Zéro gadget Win32 natif • 60 FPS non-bloquant" 
                Height="36" 
                FontName="Segoe UI" FontSize="9"
                Background="#1E293B" Foreground="#64748B" 
                BorderColor="#334155" BorderThickness="1" CornerRadius="8" 
                Padding="16,0,16,0" HAlign="Center" Transparent="False" />

  </StackPanel>
</Window>
