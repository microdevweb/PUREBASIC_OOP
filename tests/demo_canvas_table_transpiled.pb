        If FindMapElement(*This\propFloats(), pKey)
          ProcedureReturn *This\propFloats()
        EndIf
        ProcedureReturn 0.0
EndProcedure

Procedure.b MVVM_ObservableObject_SetDouble(*This.MVVM_ObservableObject_Inst, propName.s, val.d)
  Protected *This_vt.MVVM_ObservableObject_vt = *This
        Protected pKey.s = LCase(propName)
        If FindMapElement(*This\propFloats(), pKey)
          If *This\propFloats() = val
            ProcedureReturn #False ; No change
