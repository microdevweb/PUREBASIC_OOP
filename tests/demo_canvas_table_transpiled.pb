Procedure MVVM_ObservableObject_Init(*This.MVVM_ObservableObject_Inst)
  Protected *This_vt.MVVM_ObservableObject_vt = *This
EndProcedure

Procedure MVVM_ObservableObject_Free(*This.MVVM_ObservableObject_Inst)
  Protected *This_vt.MVVM_ObservableObject_vt = *This
        ClearMap(*This\propStrings())
        ClearMap(*This\propInts())
        ClearMap(*This\propBools())
        ClearMap(*This\propFloats())
        ClearList(*This\observers())
EndProcedure

Procedure MVVM_ObservableObject_RegisterObserver(*This.MVVM_ObservableObject_Inst, *observer, *cb)
  Protected *This_vt.MVVM_ObservableObject_vt = *This
        If *observer And *cb
          ; Check if already registered
          ForEach *This\observers()
            If *This\observers()\observer = *observer
              *This\observers()\callback = *cb
              ProcedureReturn
            EndIf
          Next
  
          AddElement(*This\observers())
          *This\observers()\observer = *observer
          *This\observers()\callback = *cb
        EndIf
EndProcedure

Procedure MVVM_ObservableObject_UnregisterObserver(*This.MVVM_ObservableObject_Inst, *observer)
  Protected *This_vt.MVVM_ObservableObject_vt = *This
        If *observer
          ForEach *This\observers()
            If *This\observers()\observer = *observer
              DeleteElement(*This\observers())
              Break
            EndIf
          Next
        EndIf
EndProcedure

Procedure MVVM_ObservableObject_NotifyPropertyChanged(*This.MVVM_ObservableObject_Inst, propName.s)
  Protected *This_vt.MVVM_ObservableObject_vt = *This
        Protected pKey.s = LCase(propName)
        ForEach *This\observers()
          If *This\observers()\callback
            CallFunctionFast(*This\observers()\callback, *This, @pKey)
          EndIf
        Next
EndProcedure

Procedure.s MVVM_ObservableObject_Get(*This.MVVM_ObservableObject_Inst, propName.s)
  Protected *This_vt.MVVM_ObservableObject_vt = *This
        ProcedureReturn *This_vt\GetValueAsString(propName)
EndProcedure

