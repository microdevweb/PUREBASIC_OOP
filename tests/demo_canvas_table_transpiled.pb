Procedure.b UI_Window_LoadView(*This.UI_Window_Inst, xmlPath.s, *dataContext_p)
  Protected *This_vt.UI_Window_vt = *This
  If (*dataContext_p)
          *This_vt\SetDataContext(*dataContext_p)
  EndIf
        Protected *loader.UI_XMLLoader_vt = New_UI_XMLLoader()
        Protected res.b = #False
  If (*loader)
          res = *loader\LoadFromFile(xmlPath, *This)
          *loader\Free()
  EndIf
        ProcedureReturn res
EndProcedure

