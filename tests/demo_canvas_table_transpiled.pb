Procedure MVVM_ObservableCollection_Init(*This.MVVM_ObservableCollection_Inst)
  Protected *This_vt.MVVM_ObservableCollection_vt = *This
        MVVM_ObservableObject_Init(*This)
EndProcedure

Procedure MVVM_ObservableCollection_Free(*This.MVVM_ObservableCollection_Inst)
  Protected *This_vt.MVVM_ObservableCollection_vt = *This
        ClearList(*This\items())
        ClearList(*This\colObservers())
        MVVM_ObservableObject_Free(*This)
EndProcedure

Procedure MVVM_ObservableCollection_RegisterCollectionObserver(*This.MVVM_ObservableCollection_Inst, *observer, *cb)
  Protected *This_vt.MVVM_ObservableCollection_vt = *This
        If *observer And *cb
          ForEach *This\colObservers()
            If *This\colObservers()\observer = *observer
              *This\colObservers()\callback = *cb
              ProcedureReturn
            EndIf
          Next
  
          AddElement(*This\colObservers())
          *This\colObservers()\observer = *observer
          *This\colObservers()\callback = *cb
        EndIf
EndProcedure

Procedure MVVM_ObservableCollection_UnregisterCollectionObserver(*This.MVVM_ObservableCollection_Inst, *observer)
  Protected *This_vt.MVVM_ObservableCollection_vt = *This
        If *observer
          ForEach *This\colObservers()
            If *This\colObservers()\observer = *observer
              DeleteElement(*This\colObservers())
              Break
            EndIf
          Next
        EndIf
EndProcedure

Procedure MVVM_ObservableCollection_NotifyCollectionChanged(*This.MVVM_ObservableCollection_Inst, actionType.i, index.i, itemText.s)
  Protected *This_vt.MVVM_ObservableCollection_vt = *This
        ForEach *This\colObservers()
          If *This\colObservers()\callback
            CallFunctionFast(*This\colObservers()\callback, *This, actionType, index, @itemText)
          EndIf
        Next
        *This_vt\NotifyPropertyChanged("Count")
EndProcedure

Procedure MVVM_ObservableCollection_Add(*This.MVVM_ObservableCollection_Inst, item.s)
  Protected *This_vt.MVVM_ObservableCollection_vt = *This
        AddElement(*This\items())
        *This\items() = item
        Protected idx.i = ListIndex(*This\items())
        *This_vt\NotifyCollectionChanged(#UI_CollectionAction_Add, idx, item)
EndProcedure

Procedure MVVM_ObservableCollection_Insert(*This.MVVM_ObservableCollection_Inst, index.i, item.s)
  Protected *This_vt.MVVM_ObservableCollection_vt = *This
        If index >= 0 And index <= ListSize(*This\items())
          SelectElement(*This\items(), index)
          InsertElement(*This\items())
          *This\items() = item
          *This_vt\NotifyCollectionChanged(#UI_CollectionAction_Add, index, item)
        Else
          *This_vt\Add(item)
        EndIf
EndProcedure

Procedure MVVM_ObservableCollection_Remove(*This.MVVM_ObservableCollection_Inst, index.i)
  Protected *This_vt.MVVM_ObservableCollection_vt = *This
        If index >= 0 And index < ListSize(*This\items())
          SelectElement(*This\items(), index)
          Protected removedText.s = *This\items()
          DeleteElement(*This\items())
          *This_vt\NotifyCollectionChanged(#UI_CollectionAction_Remove, index, removedText)
        EndIf
EndProcedure

Procedure MVVM_ObservableCollection_Clear(*This.MVVM_ObservableCollection_Inst)
  Protected *This_vt.MVVM_ObservableCollection_vt = *This
        ClearList(*This\items())
        *This_vt\NotifyCollectionChanged(#UI_CollectionAction_Clear, 0, "")
EndProcedure

Procedure.i MVVM_ObservableCollection_Count(*This.MVVM_ObservableCollection_Inst)
  Protected *This_vt.MVVM_ObservableCollection_vt = *This
        ProcedureReturn ListSize(*This\items())
EndProcedure

Procedure.s MVVM_ObservableCollection_GetItem(*This.MVVM_ObservableCollection_Inst, index.i)
  Protected *This_vt.MVVM_ObservableCollection_vt = *This
        If index >= 0 And index < ListSize(*This\items())
          SelectElement(*This\items(), index)
          ProcedureReturn *This\items()
        EndIf
        ProcedureReturn ""
EndProcedure

Procedure MVVM_ObservableCollection_SetItem(*This.MVVM_ObservableCollection_Inst, index.i, item.s)
  Protected *This_vt.MVVM_ObservableCollection_vt = *This
        If index >= 0 And index < ListSize(*This\items())
          SelectElement(*This\items(), index)
          *This\items() = item
          *This_vt\NotifyCollectionChanged(#UI_CollectionAction_Update, index, item)
        EndIf
EndProcedure

