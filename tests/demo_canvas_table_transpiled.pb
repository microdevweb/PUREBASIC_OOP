  Protected *This_vt.MVVM_RelayCommand_vt = *This
        *This\actionProc = *action
        *This\canExecuteProc = 0
EndProcedure

Procedure MVVM_RelayCommand_Init_p_p(*This.MVVM_RelayCommand_Inst, *action, *canExec)
  Protected *This_vt.MVVM_RelayCommand_vt = *This
        *This\actionProc = *action
        *This\canExecuteProc = *canExec
EndProcedure

Procedure MVVM_RelayCommand_Free(*This.MVVM_RelayCommand_Inst)
  Protected *This_vt.MVVM_RelayCommand_vt = *This
        *This\actionProc = 0
        *This\canExecuteProc = 0
EndProcedure

Procedure.b MVVM_RelayCommand_CanExecute(*This.MVVM_RelayCommand_Inst, *param)
  Protected *This_vt.MVVM_RelayCommand_vt = *This
        If *This\canExecuteProc
          ProcedureReturn CallFunctionFast(*This\canExecuteProc, *param)
        EndIf
        ProcedureReturn #True
EndProcedure

Procedure MVVM_RelayCommand_Execute(*This.MVVM_RelayCommand_Inst, *param)
  Protected *This_vt.MVVM_RelayCommand_vt = *This
        If *This_vt\CanExecute(*param)
          If *This\actionProc
            CallFunctionFast(*This\actionProc, *param)
          EndIf
        EndIf
EndProcedure

Procedure MVVM_ViewModelBase_Init(*This.MVVM_ViewModelBase_Inst)
  Protected *This_vt.MVVM_ViewModelBase_vt = *This
        MVVM_ObservableObject_Init(*This)
EndProcedure

Procedure MVVM_ViewModelBase_Free(*This.MVVM_ViewModelBase_Inst)
  Protected *This_vt.MVVM_ViewModelBase_vt = *This
        ForEach *This\commands()
          If *This\commands()
            *This\commands()\Free()
          EndIf
        Next
        ClearMap(*This\commands())
        CompilerIf Defined(UI_MVVM_UnregisterAll, #PB_Procedure)
          UI_MVVM_UnregisterAll(*This)
        CompilerEndIf
        MVVM_ObservableObject_Free(*This)
EndProcedure

Procedure MVVM_ViewModelBase_RegisterCommand(*This.MVVM_ViewModelBase_Inst, name_p.s, *cmd.MVVM_RelayCommand_vt)
  Protected *This_vt.MVVM_ViewModelBase_vt = *This
        If name_p <> "" And *cmd
          *This\commands(LCase(name_p)) = *cmd
        EndIf
EndProcedure

Procedure.i MVVM_ViewModelBase_GetCommand(*This.MVVM_ViewModelBase_Inst, name_p.s)
  Protected *This_vt.MVVM_ViewModelBase_vt = *This
        Protected cKey.s = LCase(name_p)
        If FindMapElement(*This\commands(), cKey)
          ProcedureReturn *This\commands()
        EndIf
        ProcedureReturn 0
EndProcedure

Procedure.b MVVM_ViewModelBase_ExecuteCommand(*This.MVVM_ViewModelBase_Inst, name_p.s, *param)
  Protected *This_vt.MVVM_ViewModelBase_vt = *This
        Protected *cmd.MVVM_RelayCommand_vt = *This_vt\GetCommand(name_p)
        If *cmd
          If *cmd\CanExecute(*param)
            *cmd\Execute(*param)
            ProcedureReturn #True
          EndIf
        EndIf
        ; Fallback to virtual OnCommand for zero-boilerplate command handling
        ProcedureReturn *This_vt\OnCommand(name_p, *param)
EndProcedure

