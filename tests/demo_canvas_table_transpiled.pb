Procedure.s MVVM_ObservableObject_GetString(*This.MVVM_ObservableObject_Inst, propName.s)
  Protected *This_vt.MVVM_ObservableObject_vt = *This
        Protected pKey.s = LCase(propName)
        If FindMapElement(*This\propStrings(), pKey)
          ProcedureReturn *This\propStrings()
        EndIf
        ProcedureReturn ""
EndProcedure

Procedure.b MVVM_ObservableObject_SetString(*This.MVVM_ObservableObject_Inst, propName.s, val.s)
  Protected *This_vt.MVVM_ObservableObject_vt = *This
        Protected pKey.s = LCase(propName)
        If FindMapElement(*This\propStrings(), pKey)
          If *This\propStrings() = val
            ProcedureReturn #False ; No change
          EndIf
        EndIf
        *This\propStrings(pKey) = val
        *This_vt\NotifyPropertyChanged(propName)
        ProcedureReturn #True
EndProcedure

