        ProcedureReturn *This\isActive
EndProcedure

Procedure Demo_Person_SetIsActive(*This.Demo_Person_Inst, v.b)
  Protected *This_vt.Demo_Person_vt = *This
        *This\isActive = v
EndProcedure

Procedure.s Demo_Person_GetFullName(*This.Demo_Person_Inst)
  Protected *This_vt.Demo_Person_vt = *This
        ProcedureReturn *This\firstName + " " + *This\surname
EndProcedure

Procedure Demo_TableDemoWindow_Init(*This.Demo_TableDemoWindow_Inst)
  Protected *This_vt.Demo_TableDemoWindow_vt = *This
        UI_Window_Init_s_i_i_i(*This, "Démonstrateur PureBasic OOP - UI_CanvasTable (Modern High-DPI Virtual DataGrid)", 1040, 660, #PB_Window_SystemMenu | #PB_Window_ScreenCentered | #PB_Window_SizeGadget | #PB_Window_MaximizeGadget | #PB_Window_MinimizeGadget)
        UI_RegisterWindow(*This\id, *This)
  
        *This\isDark = #False
        *This_vt\LoadAssets()
        *This_vt\BuildUI()
        *This_vt\ConfigureTable()
        *This_vt\GenerateSampleData()
  
        ; Select first row by default
        If (*This\table\GetRowCount() > 0)
          *This\table\SetSelectedIndex(0)
          *This_vt\OnRowSelected(*This\table\GetRow(0))
        EndIf
EndProcedure

Procedure Demo_TableDemoWindow_LoadAssets(*This.Demo_TableDemoWindow_Inst)
  Protected *This_vt.Demo_TableDemoWindow_vt = *This
        *This\img_warning = CatchImage(#PB_Any, ?war_img)
        *This\img_phone   = CatchImage(#PB_Any, ?phone_img)
        *This\img_busnes  = CatchImage(#PB_Any, ?bus_img)
EndProcedure

Procedure Demo_TableDemoWindow_BuildUI(*This.Demo_TableDemoWindow_Inst)
  Protected *This_vt.Demo_TableDemoWindow_vt = *This
        ; Root Layout: DockPanel
        Protected *rootDock.UI_Layouts_DockPanel_vt = New_UI_Layouts_DockPanel_void()
        *rootDock\SetLastChildFill(#True)
  
        ; 1. Top Toolbar (StackPanel Horizontal)
        Protected *topBar.UI_Layouts_StackPanel_vt = New_UI_Layouts_StackPanel_i(#UI_Orientation_Horizontal)
        *topBar\SetHeight(48)
        *topBar\SetMargin(10, 8, 10, 4)
        *topBar\SetSpacing(10)
  
        *This\btnAdd = New_UI_CanvasButton_s_i_i("➕ Ajouter Ligne", 140, 34)
        *This\btnAdd\SetPrimaryStyle()
        *topBar\AddChild(*This\btnAdd)
        BindGadgetEvent(*This\btnAdd\GetId(), @Toolbar_OnAddClicked(), #PB_EventType_LeftClick)
  
        *This\btnDarkMode = New_UI_CanvasButton_s_i_i("Mode Sombre 🌙", 140, 34)
        *topBar\AddChild(*This\btnDarkMode)
        BindGadgetEvent(*This\btnDarkMode\GetId(), @Toolbar_OnToggleThemeClicked(), #PB_EventType_LeftClick)
  
        *rootDock\AddDockChild(*topBar, #UI_Dock_Top)
  
        ; 2. Bottom Status Bar
        *This\lblStatus = New_UI_Label_s("Prêt. Cliquez sur un en-tête pour trier, glissez les séparateurs pour redimensionner, double-cliquez pour éditer.")
        *This\lblStatus\SetHeight(28)
        *This\lblStatus\SetMargin(12, 4, 12, 4)
        *rootDock\AddDockChild(*This\lblStatus, #UI_Dock_Bottom)
  
        ; 3. Right Detail Inspector Form
        Protected *detailPanel.UI_Layouts_StackPanel_vt = New_UI_Layouts_StackPanel_i(#UI_Orientation_Vertical)
        *detailPanel\SetWidth(280)
        *detailPanel\SetMargin(8, 8, 12, 8)
        *detailPanel\SetSpacing(6)
  
        Protected *lblFicTitle.UI_Label_vt = New_UI_Label_s("Fiche Détail Client")
        *detailPanel\AddChild(*lblFicTitle)
  
        Protected *lblFN.UI_Label_vt = New_UI_Label_s("Prénom :")
        *detailPanel\AddChild(*lblFN)
        *This\txtFirstName = New_UI_TextBox_s_i_i("", 260, 30)
        *detailPanel\AddChild(*This\txtFirstName)
  
        Protected *lblSN.UI_Label_vt = New_UI_Label_s("Nom :")
        *detailPanel\AddChild(*lblSN)
        *This\txtSurname = New_UI_TextBox_s_i_i("", 260, 30)
        *detailPanel\AddChild(*This\txtSurname)
  
        Protected *lblAge.UI_Label_vt = New_UI_Label_s("Âge :")
        *detailPanel\AddChild(*lblAge)
        *This\txtAge = New_UI_TextBox_s_i_i("", 260, 30)
        *detailPanel\AddChild(*This\txtAge)
  
        Protected *lblSize.UI_Label_vt = New_UI_Label_s("Taille (cm) :")
        *detailPanel\AddChild(*lblSize)
        *This\txtSize = New_UI_TextBox_s_i_i("", 260, 30)
        *detailPanel\AddChild(*This\txtSize)
  
        Protected *lblWeight.UI_Label_vt = New_UI_Label_s("Poids (kg) :")
        *detailPanel\AddChild(*lblWeight)
        *This\txtWeight = New_UI_TextBox_s_i_i("", 260, 30)
        *detailPanel\AddChild(*This\txtWeight)
  
        *rootDock\AddDockChild(*detailPanel, #UI_Dock_Right)
  
        ; 4. Center: CanvasTable
        *This\table = New_UI_CanvasTable_i_i(700, 520)
        *This\table\SetMargin(10, 4, 4, 8)
        *This\table\SetLineHeight(30)
        *This\table\SetHeaderHeight(34)
        *This\table\SetShowAlternatingColors(#True)
        *This\table\SetShowGridLines(#True)
  
        *rootDock\AddDockChild(*This\table, #UI_Dock_Fill)
        *This_vt\SetContent(*rootDock)
EndProcedure

Procedure Demo_TableDemoWindow_ConfigureTable(*This.Demo_TableDemoWindow_Inst)
  Protected *This_vt.Demo_TableDemoWindow_vt = *This
        ; Add columns with types and getters/setters (PB_TABLE pattern)
        Protected *colActif.UI_TableColumn_vt = *This\table\AddColumn("Actif", 55, #UI_TableCol_CheckBox, #UI_TableAlign_Center)
        *colActif\SetGetter(@Person_GetIsActive())
        *colActif\SetSetter(@Person_SetIsActive())
  
        Protected *colIcon.UI_TableColumn_vt = *This\table\AddColumn("Statut", 60, #UI_TableCol_Image, #UI_TableAlign_Center)
        *colIcon\SetGetter(@Person_GetIcon())
  
        Protected *colFN.UI_TableColumn_vt = *This\table\AddColumn("Prénom", 130, #UI_TableCol_Text, #UI_TableAlign_Left)
        *colFN\SetGetter(@Person_GetFirstName())
        *colFN\SetSetter(@Person_SetFirstName())
  
        Protected *colSN.UI_TableColumn_vt = *This\table\AddColumn("Nom", 130, #UI_TableCol_Text, #UI_TableAlign_Left)
        *colSN\SetGetter(@Person_GetSurname())
        *colSN\SetSetter(@Person_SetSurname())
  
        Protected *colAge.UI_TableColumn_vt = *This\table\AddColumn("Âge", 75, #UI_TableCol_Number, #UI_TableAlign_Right)
        *colAge\SetDecimals(0)
        *colAge\SetGetter(@Person_GetAge())
        *colAge\SetSetter(@Person_SetAge())
  
        Protected *colSize.UI_TableColumn_vt = *This\table\AddColumn("Taille", 85, #UI_TableCol_Float, #UI_TableAlign_Right)
        *colSize\SetDecimals(2)
        *colSize\SetGetter(@Person_GetSize())
        *colSize\SetSetter(@Person_SetSize())
  
        Protected *colWeight.UI_TableColumn_vt = *This\table\AddColumn("Poids (kg)", 95, #UI_TableCol_Double, #UI_TableAlign_Right)
        *colWeight\SetDecimals(2)
        *colWeight\SetGetter(@Person_GetWeight())
        *colWeight\SetSetter(@Person_SetWeight())
  
        ; Column with action buttons
        Protected *colAction.UI_TableColumn_vt = *This\table\AddColumn("Actions", 80, #UI_TableCol_ActionButtons, #UI_TableAlign_Center)
        *colAction\AddButton(1, 0, "Édit", "Modifier la ligne")
        *colAction\AddButton(2, 0, "Suppr", "Supprimer la ligne")
        *colAction\SetSortable(#False)
  
        ; Hook table event callbacks
        *This\table\SetOnSelect(@TableEvent_OnSelect())
        *This\table\SetOnCellEdit(@TableEvent_OnCellEdit())
        *This\table\SetOnHeaderClick(@TableEvent_OnHeaderClick())
        *This\table\SetOnCheck(@TableEvent_OnCheck())
        *This\table\SetOnButtonClick(@TableEvent_OnButtonClick())
EndProcedure

Procedure Demo_TableDemoWindow_AddPerson(*This.Demo_TableDemoWindow_Inst, fn.s, sn.s, a.l, s.f, w.d, ic.i, act.b)
  Protected *This_vt.Demo_TableDemoWindow_vt = *This
        Protected *p.Demo_Person_vt = New_Demo_Person(fn, sn, a, s, w, ic, act)
        AddElement(*This\people())
        *This\people() = *p
        *This\table\AddRowData(*p)
EndProcedure

Procedure Demo_TableDemoWindow_GenerateSampleData(*This.Demo_TableDemoWindow_Inst)
  Protected *This_vt.Demo_TableDemoWindow_vt = *This
        *This_vt\AddPerson("Pierre", "Bielen", 55, 175.10, 80.62, *This\img_busnes, #True)
        *This_vt\AddPerson("André", "Dupond", 48, 165.25, 70.43, *This\img_warning, #False)
        *This_vt\AddPerson("Paul", "Godelaine", 49, 170.38, 90.76, *This\img_phone, #True)
        *This_vt\AddPerson("Eric", "Bosly", 50, 164.19, 110.25, *This\img_busnes, #True)
  
        ; 50 additional items to showcase virtual scrolling performance
        Protected i.i, remSize.i, remWeight.i, ic.i, act.b
        For i = 1 To 50
          remSize = i % 25
          remWeight = i % 35
          If (i % 3 = 0)
            ic = *This\img_warning
            act = #False
          ElseIf (i % 3 = 1)
            ic = *This\img_phone
            act = #True
          Else
            ic = *This\img_busnes
            act = #True
          EndIf
          *This_vt\AddPerson("Employé " + Str(i), "Nom" + Str(i), Random(65, 22), 160.0 + remSize, 60.0 + remWeight, ic, act)
        Next
EndProcedure

Procedure Demo_TableDemoWindow_OnAddRandomPerson(*This.Demo_TableDemoWindow_Inst)
  Protected *This_vt.Demo_TableDemoWindow_vt = *This
        *This_vt\AddPerson("Nouvel", "Utilisateur", Random(50, 20), 175.0 + Random(15), 70.0 + Random(20), *This\img_busnes, #True)
        *This\table\SetSelectedIndex(*This\table\GetRowCount() - 1)
        If (*This\lblStatus)
          *This\lblStatus\SetText("Ajout d'une nouvelle personne (Total: " + Str(*This\table\GetRowCount()) + " lignes)")
        EndIf
EndProcedure

Procedure Demo_TableDemoWindow_OnRowSelected(*This.Demo_TableDemoWindow_Inst, *row.UI_TableRow_vt)
  Protected *This_vt.Demo_TableDemoWindow_vt = *This
        If (*row And *row\GetDataContext())
          Protected *p.Demo_Person_vt = *row\GetDataContext()
          If (*This\txtFirstName) : *This\txtFirstName\SetText(*p\GetFirstName()) : EndIf
          If (*This\txtSurname)   : *This\txtSurname\SetText(*p\GetSurname())     : EndIf
          If (*This\txtAge)       : *This\txtAge\SetText(Str(*p\GetAge()))        : EndIf
          If (*This\txtSize)      : *This\txtSize\SetText(StrF(*p\GetSize(), 2))  : EndIf
          If (*This\txtWeight)    : *This\txtWeight\SetText(StrD(*p\GetWeight(), 2)) : EndIf
          If (*This\lblStatus)
            *This\lblStatus\SetText("Sélection: " + *p\GetFullName() + " | Âge: " + Str(*p\GetAge()) + " | Actif: " + Str(*p\GetIsActive()))
          EndIf
        EndIf
EndProcedure

Procedure Demo_TableDemoWindow_OnCellEdited(*This.Demo_TableDemoWindow_Inst, *row.UI_TableRow_vt, colIdx.i, newVal.s)
  Protected *This_vt.Demo_TableDemoWindow_vt = *This
        If (*row And *row\GetDataContext())
          Protected *p.Demo_Person_vt = *row\GetDataContext()
          If (*This\lblStatus)
            *This\lblStatus\SetText("Édition cellule Col #" + Str(colIdx) + " validée -> " + newVal + " (pour " + *p\GetFullName() + ")")
          EndIf
          *This_vt\OnRowSelected(*row)
        EndIf
EndProcedure

Procedure Demo_TableDemoWindow_OnHeaderClicked(*This.Demo_TableDemoWindow_Inst, *col.UI_TableColumn_vt, order.i)
  Protected *This_vt.Demo_TableDemoWindow_vt = *This
        Protected orderStr.s = "Aucun"
        If (order = #UI_TableSort_Asc)  : orderStr = "Croissant (▲)" : EndIf
        If (order = #UI_TableSort_Desc) : orderStr = "Décroissant (▼)" : EndIf
        If (*This\lblStatus)
          *This\lblStatus\SetText("Tri sur la colonne '" + *col\GetTitle() + "' -> " + orderStr)
        EndIf
EndProcedure

Procedure Demo_TableDemoWindow_OnRowChecked(*This.Demo_TableDemoWindow_Inst, *row.UI_TableRow_vt, isChecked.b)
  Protected *This_vt.Demo_TableDemoWindow_vt = *This
        If (*row And *row\GetDataContext())
          Protected *p.Demo_Person_vt = *row\GetDataContext()
          *p\SetIsActive(isChecked)
          If (*This\lblStatus)
            *This\lblStatus\SetText("Statut Actif basculé pour " + *p\GetFullName() + " -> " + Str(isChecked))
          EndIf
        EndIf
EndProcedure

Procedure Demo_TableDemoWindow_OnRowActionButton(*This.Demo_TableDemoWindow_Inst, *row.UI_TableRow_vt, buttonId.i)
  Protected *This_vt.Demo_TableDemoWindow_vt = *This
        If (*row And *row\GetDataContext())
          Protected *p.Demo_Person_vt = *row\GetDataContext()
          If (buttonId = 1) ; Edit button
            If (*This\lblStatus)
              *This\lblStatus\SetText("Action [Édition] cliquée pour " + *p\GetFullName())
            EndIf
            *This\table\StartEdit(*This\table\GetSelectedIndex(), 0)
          ElseIf (buttonId = 2) ; Delete button
            If (*This\lblStatus)
              *This\lblStatus\SetText("Action [Supprimer] cliquée pour " + *p\GetFullName())
            EndIf
            *This\table\RemoveRow(*This\table\GetSelectedIndex())
          EndIf
        EndIf
EndProcedure

Procedure Demo_TableDemoWindow_ToggleTheme(*This.Demo_TableDemoWindow_Inst)
  Protected *This_vt.Demo_TableDemoWindow_vt = *This
        *This\isDark = Bool(Not *This\isDark)
        *This\table\SetDarkMode(*This\isDark)
        If (*This\isDark)
          *This\btnDarkMode\SetText("Mode Clair ☀️")
          *This\btnDarkMode\SetDarkStyle()
        Else
          *This\btnDarkMode\SetText("Mode Sombre 🌙")
          *This\btnDarkMode\SetDefaultStyle()
        EndIf
EndProcedure

