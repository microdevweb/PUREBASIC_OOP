Procedure UI_CanvasTable_RemoveRow(*This.UI_CanvasTable_Inst, index_p.i)
  Protected *This_vt.UI_CanvasTable_vt = *This
        If (index_p >= 0 And index_p < ListSize(*This\rows()))
          SelectElement(*This\rows(), index_p)
          Protected *r.UI_TableRow_vt = *This\rows()
          If (*r) : *r\Free() : EndIf
          DeleteElement(*This\rows())
          If (*This\selectedRowIndex >= ListSize(*This\rows()))
            *This\selectedRowIndex = ListSize(*This\rows()) - 1
          EndIf
          *This_vt\RecalculateScroll()
          *This_vt\Redraw()
        EndIf
EndProcedure

Procedure UI_CanvasTable_ClearRows(*This.UI_CanvasTable_Inst)
  Protected *This_vt.UI_CanvasTable_vt = *This
        *This_vt\CancelEdit()
  ForEach *This\rows()
          Protected *r.UI_TableRow_vt = *This\rows()
          If (*r) : *r\Free() : EndIf
  Next
        ClearList(*This\rows())
        *This\selectedRowIndex = -1
        *This\scrollY = 0
        *This_vt\RecalculateScroll()
        *This_vt\Redraw()
EndProcedure

Procedure UI_CanvasTable_ClearAll(*This.UI_CanvasTable_Inst)
