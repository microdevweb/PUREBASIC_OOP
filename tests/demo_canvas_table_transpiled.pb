Procedure UI_Layouts_Container_RemoveChild(*This.UI_Layouts_Container_Inst, *child.UI_Component_vt)
  Protected *This_vt.UI_Layouts_Container_vt = *This
        If *child
          ForEach *This\children()
            If *This\children() = *child
              DeleteElement(*This\children())
              Break
            EndIf
          Next
          *This_vt\UpdateLayout()
        EndIf
EndProcedure

