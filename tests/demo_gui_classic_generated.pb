Procedure.i New_UI_Window(title_p.s, x_p.i = #PB_Ignore, y_p.i = #PB_Ignore, w_p.i = 640, h_p.i = 480, flags_p.i = #PB_Window_SystemMenu | #PB_Window_ScreenCentered | #PB_Window_SizeGadget | #PB_Window_MinimizeGadget | #PB_Window_MaximizeGadget, parent_p.i = 0)
  Protected *obj.UI_Window_Inst = AllocateStructure(UI_Window_Inst)
  If *obj
    *obj\VTable = ?UI_Window_VTable_Data
    UI_Window_Init(*obj, title_p, x_p, y_p, w_p, h_p, flags_p, parent_p)
  EndIf
  ProcedureReturn *obj
EndProcedure

Procedure Free_UI_Window(*obj.UI_Window_Inst)
  If *obj
    UI_Window_Free(*obj)
    FreeStructure(*obj)
  EndIf
EndProcedure

