Procedure UI_Window_Init(*This.UI_Window_Inst, title_p.s, x_p.i = #PB_Ignore, y_p.i = #PB_Ignore, w_p.i = 640, h_p.i = 480, flags_p.i = #PB_Window_SystemMenu | #PB_Window_ScreenCentered | #PB_Window_SizeGadget | #PB_Window_MinimizeGadget | #PB_Window_MaximizeGadget, parent_p.i = 0)
  Protected *This_vt.UI_Window_vt = *This
        *This\title = title_p
        *This\flags = flags_p
        *This\parentID = parent_p
        *This\id = OpenWindow(#PB_Any, x_p, y_p, w_p, h_p, title_p, flags_p, parent_p)
  If (*This\id)
          UI_RegisterWindow(*This\id, @*This)
          *This\x = WindowX(*This\id)
          *This\y = WindowY(*This\id)
          *This\width = WindowWidth(*This\id)
          *This\height = WindowHeight(*This\id)
          *This\isVisible = #True
          *This\isEnabled = #True
  EndIf
EndProcedure

