Procedure UI_Application_Init(*This.UI_Application_Inst)
  Protected *This_vt.UI_Application_vt = *This
        *This\isRunning = #False
        *This\mainWindow = #Null
EndProcedure

Procedure UI_Application_SetMainWindow(*This.UI_Application_Inst, *win_p.UI_Window_vt)
  Protected *This_vt.UI_Application_vt = *This
        *This\mainWindow = *win_p
EndProcedure

Procedure.i UI_Application_GetMainWindow(*This.UI_Application_Inst)
  Protected *This_vt.UI_Application_vt = *This
        ProcedureReturn *This\mainWindow
EndProcedure

Procedure UI_Application_Run(*This.UI_Application_Inst, *mainWin_p.UI_Window_vt = 0)
  Protected *This_vt.UI_Application_vt = *This
  If (*mainWin_p)
          *This\mainWindow = *mainWin_p
  EndIf
        *This\isRunning = #True
        Protected ev.i, evGadget.i, evWin.i, evType.i
  
  While (*This\isRunning)
          ev = WaitWindowEvent()
          evWin = EventWindow()
          evType = EventType()
  
  Select (ev)
            Case #PB_Event_Gadget:
              evGadget = EventGadget()
  If (FindMapElement(UI_GadgetMap(), Str(evGadget)))
                Protected *targetGadget.UI_Gadget_vt = UI_GadgetMap()
  If (*targetGadget)
  Select (evType)
                    Case #PB_EventType_LeftClick:   *targetGadget\OnClick()
                    Case #PB_EventType_Change:      *targetGadget\OnChange()
                    Case #PB_EventType_Focus:       *targetGadget\OnFocus()
                    Case #PB_EventType_LostFocus:   *targetGadget\OnLostFocus()
                    Case #PB_EventType_RightClick:  *targetGadget\OnRightClick()
                    Default:                        *targetGadget\OnCustomEvent(evType)
  EndSelect
  EndIf
  EndIf
  
            Case #PB_Event_CloseWindow:
  If (FindMapElement(UI_WindowMap(), Str(evWin)))
                Protected *targetWin.UI_Window_vt = UI_WindowMap()
  If (*targetWin)
  If (*targetWin\OnClose())
                    *targetWin\Close()
                    UI_UnregisterWindow(evWin)
  If (*targetWin = *This\mainWindow Or MapSize(UI_WindowMap()) = 0)
                      *This\isRunning = #False
  EndIf
  EndIf
  EndIf
  Else
                CloseWindow(evWin)
  EndIf
  
            Case #PB_Event_SizeWindow:
  If (FindMapElement(UI_WindowMap(), Str(evWin)))
                Protected *targetWinSize.UI_Window_vt = UI_WindowMap()
  If (*targetWinSize)
                  *targetWinSize\OnResize(WindowWidth(evWin), WindowHeight(evWin))
  EndIf
  EndIf
  
            Case #PB_Event_MoveWindow:
  If (FindMapElement(UI_WindowMap(), Str(evWin)))
                Protected *targetWinMove.UI_Window_vt = UI_WindowMap()
  If (*targetWinMove)
                  *targetWinMove\OnMove(WindowX(evWin), WindowY(evWin))
  EndIf
  EndIf
  
            Case #PB_Event_MinimizeWindow:
  If (FindMapElement(UI_WindowMap(), Str(evWin)))
                Protected *targetWinMin.UI_Window_vt = UI_WindowMap()
  If (*targetWinMin)
                  *targetWinMin\OnMinimize()
  EndIf
  EndIf
  
            Case #PB_Event_MaximizeWindow:
  If (FindMapElement(UI_WindowMap(), Str(evWin)))
                Protected *targetWinMax.UI_Window_vt = UI_WindowMap()
  If (*targetWinMax)
                  *targetWinMax\OnMaximize()
  EndIf
  EndIf
  
            Case #PB_Event_RestoreWindow:
  If (FindMapElement(UI_WindowMap(), Str(evWin)))
                Protected *targetWinRest.UI_Window_vt = UI_WindowMap()
  If (*targetWinRest)
                  *targetWinRest\OnRestore()
  EndIf
  EndIf
  EndSelect
  Wend
EndProcedure

Procedure UI_Application_Quit(*This.UI_Application_Inst)
  Protected *This_vt.UI_Application_vt = *This
        *This\isRunning = #False
EndProcedure

Procedure UI_CustomGadget_Init(*This.UI_CustomGadget_Inst, x_p.i, y_p.i, w_p.i = 100, h_p.i = 30, flags_p.i = 0)
  Protected *This_vt.UI_CustomGadget_vt = *This
        *This\x = x_p : *This\y = y_p : *This\width = w_p : *This\height = h_p
        *This\isVisible = #True : *This\isEnabled = #True
        *This\isHovered = #False : *This\isPressed = #False
        *This\id = CanvasGadget(#PB_Any, x_p, y_p, w_p, h_p, flags_p | #PB_Canvas_Keyboard)
  If (*This\id)
          UI_RegisterGadget(*This\id, *This)
          *This_vt\Redraw()
  EndIf
EndProcedure

Procedure UI_CustomGadget_Redraw(*This.UI_CustomGadget_Inst)
  Protected *This_vt.UI_CustomGadget_vt = *This
  If (*This\id And IsGadget(*This\id))
  If (StartDrawing(CanvasOutput(*This\id)))
            *This_vt\OnPaint(OutputWidth(), OutputHeight())
            StopDrawing()
  EndIf
  EndIf
EndProcedure

Procedure UI_CustomGadget_OnMouseEnter(*This.UI_CustomGadget_Inst)
  Protected *This_vt.UI_CustomGadget_vt = *This
EndProcedure

Procedure UI_CustomGadget_OnMouseLeave(*This.UI_CustomGadget_Inst)
  Protected *This_vt.UI_CustomGadget_vt = *This
EndProcedure

Procedure UI_CustomGadget_OnMouseDown(*This.UI_CustomGadget_Inst, mx.i, my.i, button.i)
  Protected *This_vt.UI_CustomGadget_vt = *This
EndProcedure

Procedure UI_CustomGadget_OnMouseUp(*This.UI_CustomGadget_Inst, mx.i, my.i, button.i)
  Protected *This_vt.UI_CustomGadget_vt = *This
EndProcedure

Procedure UI_CustomGadget_OnMouseMove(*This.UI_CustomGadget_Inst, mx.i, my.i)
  Protected *This_vt.UI_CustomGadget_vt = *This
EndProcedure

Procedure UI_CustomGadget_OnKeyDown(*This.UI_CustomGadget_Inst, key.i)
  Protected *This_vt.UI_CustomGadget_vt = *This
EndProcedure

Procedure UI_CustomGadget_OnCustomEvent(*This.UI_CustomGadget_Inst, eventType.i)
  Protected *This_vt.UI_CustomGadget_vt = *This
  Select (eventType)
          Case #PB_EventType_MouseEnter:
            *This\isHovered = #True
            *This_vt\OnMouseEnter()
            *This_vt\Redraw()
  
          Case #PB_EventType_MouseLeave:
            *This\isHovered = #False
            *This\isPressed = #False
            *This_vt\OnMouseLeave()
            *This_vt\Redraw()
  
          Case #PB_EventType_LeftButtonDown:
            *This\isPressed = #True
            *This\mouseX = GetGadgetAttribute(*This\id, #PB_Canvas_MouseX)
            *This\mouseY = GetGadgetAttribute(*This\id, #PB_Canvas_MouseY)
            *This_vt\OnMouseDown(*This\mouseX, *This\mouseY, 1)
            *This_vt\Redraw()
  
          Case #PB_EventType_LeftButtonUp:
            Protected wasPressed.b = *This\isPressed
            *This\isPressed = #False
            *This\mouseX = GetGadgetAttribute(*This\id, #PB_Canvas_MouseX)
            *This\mouseY = GetGadgetAttribute(*This\id, #PB_Canvas_MouseY)
            *This_vt\OnMouseUp(*This\mouseX, *This\mouseY, 1)
  If (wasPressed)
              *This_vt\OnClick()
  EndIf
            *This_vt\Redraw()
  
          Case #PB_EventType_MouseMove:
            *This\mouseX = GetGadgetAttribute(*This\id, #PB_Canvas_MouseX)
            *This\mouseY = GetGadgetAttribute(*This\id, #PB_Canvas_MouseY)
            *This_vt\OnMouseMove(*This\mouseX, *This\mouseY)
            *This_vt\Redraw()
  
          Case #PB_EventType_KeyDown:
            *This_vt\OnKeyDown(GetGadgetAttribute(*This\id, #PB_Canvas_Key))
            *This_vt\Redraw()
  EndSelect
EndProcedure

Procedure UI_CustomGadget_Free(*This.UI_CustomGadget_Inst)
  Protected *This_vt.UI_CustomGadget_vt = *This
  If (*This\id)
          UI_UnregisterGadget(*This\id)
          UI_Gadget_Free(*This)
  EndIf
EndProcedure

