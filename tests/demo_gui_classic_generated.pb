  EndIf
EndProcedure

Procedure.s UI_Window_GetTitle(*This.UI_Window_Inst)
  Protected *This_vt.UI_Window_vt = *This
  If (*This\id And IsWindow(*This\id))
          ProcedureReturn GetWindowTitle(*This\id)
  EndIf
        ProcedureReturn *This\title
EndProcedure

