Procedure Telephone_Serialize(*This.Telephone_Inst, Map values.s())
  ClearMap(values())
  values("numero") = *This\numero
  values("type") = *This\type
  values("contact_id") = Str(*This\contact_id)
EndProcedure

Procedure Telephone_Deserialize(*This.Telephone_Inst, Map values.s())
  If FindMapElement(values(), "id") : *This\id = Val(values()) : EndIf
  If FindMapElement(values(), "numero") : *This\numero = values() : EndIf
  If FindMapElement(values(), "type") : *This\type = values() : EndIf
  If FindMapElement(values(), "contact_id") : *This\contact_id = Val(values()) : EndIf
EndProcedure

Procedure Groupe_Serialize(*This.Groupe_Inst, Map values.s())
  ClearMap(values())
  values("titre") = *This\titre
EndProcedure

Procedure Groupe_Deserialize(*This.Groupe_Inst, Map values.s())
  If FindMapElement(values(), "id") : *This\id = Val(values()) : EndIf
  If FindMapElement(values(), "titre") : *This\titre = values() : EndIf
EndProcedure

Procedure Contact_Serialize(*This.Contact_Inst, Map values.s())
  ClearMap(values())
  values("nom") = *This\nom
  values("email") = *This\email
EndProcedure

Procedure Contact_Deserialize(*This.Contact_Inst, Map values.s())
  If FindMapElement(values(), "id") : *This\id = Val(values()) : EndIf
  If FindMapElement(values(), "nom") : *This\nom = values() : EndIf
  If FindMapElement(values(), "email") : *This\email = values() : EndIf
EndProcedure

Procedure Contact_SaveChildren_telephones(*This.Contact_Inst, db.i)
  Protected targetDb.DatabaseEngine::IDatabase = Database::WrapHandle(db)
  If Not targetDb : targetDb = Database::GetDefault() : EndIf
  If Not targetDb : ProcedureReturn : EndIf
  If *This\telephones
    Protected count.i = *This\telephones\Count()
    Protected i.i
    For i = 0 To count - 1
      Protected item.DatabaseEntities::IDatabaseEntity = *This\telephones\Get(i)
      If item
        Protected *itemInst.Telephone_Inst = item
        *itemInst\contact_id = *This\id
        item\Save(targetDb)
      EndIf
    Next
    count = *This\telephones\GetRemovedCount()
    For i = 0 To count - 1
      Protected remItem.DatabaseEntities::IDatabaseEntity = *This\telephones\GetRemovedItem(i)
      If remItem : remItem\Delete(targetDb) : EndIf
    Next
    *This\telephones\ResetTracking()
  EndIf
EndProcedure

Procedure Contact_SaveChildren_groupes(*This.Contact_Inst, db.i)
  Protected targetDb.DatabaseEngine::IDatabase = Database::WrapHandle(db)
  If Not targetDb : targetDb = Database::GetDefault() : EndIf
  If Not targetDb : ProcedureReturn : EndIf
  If *This\groupes And *This\id > 0
    ORM_Relations::SyncManyToManyLinks(db, "contact_groupes", "contact_id", *This\id, "groupe_id", *This\groupes)
  EndIf
EndProcedure

Procedure Register_All_Entities()
  NewList currentFields.ORM_Schema::ORM_FieldDef()
  NewList currentRelations.ORM_Schema::ORM_RelationDef()

  ; Register entity Telephone
  ClearList(currentFields())
  ClearList(currentRelations())
  AddElement(currentFields()) : currentFields()\name = "numero" : currentFields()\typeCode = ORM_Entity::#ORM_Type_String
  AddElement(currentFields()) : currentFields()\name = "type" : currentFields()\typeCode = ORM_Entity::#ORM_Type_String
  AddElement(currentFields()) : currentFields()\name = "contact_id" : currentFields()\typeCode = ORM_Entity::#ORM_Type_Integer
  ORM_Schema::RegisterEntity("Telephone", "telephones", currentFields(), currentRelations(), @Telephone_Serialize(), @Telephone_Deserialize(), @New_Telephone(), #True)

  ; Register entity Groupe
  ClearList(currentFields())
  ClearList(currentRelations())
  AddElement(currentFields()) : currentFields()\name = "titre" : currentFields()\typeCode = ORM_Entity::#ORM_Type_String
  ORM_Schema::RegisterEntity("Groupe", "groupes", currentFields(), currentRelations(), @Groupe_Serialize(), @Groupe_Deserialize(), @New_Groupe(), #True)

  ; Register entity Contact
  ClearList(currentFields())
  ClearList(currentRelations())
  AddElement(currentFields()) : currentFields()\name = "nom" : currentFields()\typeCode = ORM_Entity::#ORM_Type_String
  AddElement(currentFields()) : currentFields()\name = "email" : currentFields()\typeCode = ORM_Entity::#ORM_Type_String
  AddElement(currentRelations())
  currentRelations()\relationType = ORM_Entity::#ORM_Rel_OneToMany
  currentRelations()\propertyName = "telephones"
  currentRelations()\childEntityType = "Telephone"
  currentRelations()\childTable = "telephones"
  currentRelations()\fkColumn = "contact_id"
  currentRelations()\joinTable = ""
  currentRelations()\parentFkColumn = "contact_id"
  currentRelations()\childFkColumn = "telephone_id"
  currentRelations()\cascadeSave = #True
  currentRelations()\saveChildrenProc = @Contact_SaveChildren_telephones()
  AddElement(currentRelations())
  currentRelations()\relationType = ORM_Entity::#ORM_Rel_ManyToMany
  currentRelations()\propertyName = "groupes"
  currentRelations()\childEntityType = "Groupe"
  currentRelations()\childTable = "groupes"
  currentRelations()\fkColumn = "contact_id"
  currentRelations()\joinTable = "contact_groupes"
  currentRelations()\parentFkColumn = "contact_id"
  currentRelations()\childFkColumn = "groupe_id"
  currentRelations()\cascadeSave = #True
  currentRelations()\saveChildrenProc = @Contact_SaveChildren_groupes()
  ORM_Schema::RegisterEntity("Contact", "contacts", currentFields(), currentRelations(), @Contact_Serialize(), @Contact_Deserialize(), @New_Contact(), #True)

EndProcedure

; ----------------------------------------------------------------------------
; 6. MAIN PROGRAM EXECUTION
; ----------------------------------------------------------------------------

Register_All_Entities()

; =============================================================================
; test_orm_relations.pbo - End-to-End ORM Relations Test
; PureBasic OOP Framework - Alpha 1.4 (Phase 2)
; =============================================================================




; =============================================================================
; MAIN TEST EXECUTION
; =============================================================================

OpenConsole()
PrintN("=================================================================")
PrintN("  ORM ALPHA 1.4 - END-TO-END RELATIONS & ENTITY TEST")
PrintN("=================================================================")

; 1. Initialisation de la base de données
DeleteFile("test_crm_orm.db")
Define *db.DatabaseEngine::IDatabase = Database::NewSQLite("test_crm_orm.db")
If Not *db
  PrintN("[FAIL] Cannot initialize SQLite database.")
  End 1
EndIf

; Set active default database
Database::SetDefault(*db)

; Auto-migration (creates contacts, telephones, groupes, and contact_groupes)
If Not *db\AutoMigrate()
  PrintN("[FAIL] AutoMigrate failed.")
  End 1
EndIf
PrintN("[PASS] AutoMigrate created all tables and junction tables.")

; 2. Création et association des entités
Define *contact.Contact_vt = New_Contact()
*contact\Set_nom("Alice Dupont")
*contact\Set_email("alice@example.com")

Define *t1.Telephone_vt = New_Telephone()
*t1\Set_numero("0123456789")
*t1\Set_type("Mobile")
*contact\Add_telephones(*t1)

Define *t2.Telephone_vt = New_Telephone()
*t2\Set_numero("0987654321")
*t2\Set_type("Bureau")
*contact\Add_telephones(*t2)

Define *g1.Groupe_vt = New_Groupe()
*g1\Set_titre("Clients VIP")
*contact\Add_groupes(*g1)

; 3. Sauvegarde en cascade via *contact\Save() (Active Record style)
Define ok.b = *contact\Save()
If Not ok
  PrintN("[FAIL] *contact\Save() returned False.")
  End 1
EndIf
PrintN("[PASS] *contact\Save() succeeded.")

; 4. Vérification des identifiants générés
If *contact\GetId() <= 0
  PrintN("[FAIL] Contact ID is <= 0: " + Str(*contact\GetId()))
  End 1
EndIf
PrintN("[PASS] Contact saved with ID: " + Str(*contact\GetId()))

If *t1\GetId() <= 0 Or *t2\GetId() <= 0
  PrintN("[FAIL] Telephones IDs not generated.")
  End 1
EndIf
PrintN("[PASS] Cascade 1-N saved telephones with IDs: " + Str(*t1\GetId()) + ", " + Str(*t2\GetId()))

If *g1\GetId() <= 0
  PrintN("[FAIL] Groupe ID not generated.")
  End 1
EndIf
PrintN("[PASS] ManyToMany saved groupe with ID: " + Str(*g1\GetId()))

; 5. Vérification directe en base SQL
Define q.i = *db\Query("SELECT COUNT(*) FROM telephones WHERE contact_id = " + Str(*contact\GetId()) + ";")
If q
  If NextDatabaseRow(*db\GetHandle())
    Define phoneCount.i = GetDatabaseLong(*db\GetHandle(), 0)
    If phoneCount = 2
      PrintN("[PASS] Verified 2 telephones in DB for contact_id = " + Str(*contact\GetId()))
    Else
      PrintN("[FAIL] Expected 2 telephones, got " + Str(phoneCount))
      End 1
    EndIf
  EndIf
  FinishDatabaseQuery(*db\GetHandle())
EndIf

Define qJunc.i = *db\Query("SELECT COUNT(*) FROM contact_groupes WHERE contact_id = " + Str(*contact\GetId()) + ";")
If qJunc
  If NextDatabaseRow(*db\GetHandle())
    Define juncCount.i = GetDatabaseLong(*db\GetHandle(), 0)
    If juncCount = 1
      PrintN("[PASS] Verified 1 link in junction table contact_groupes")
    Else
      PrintN("[FAIL] Expected 1 link in contact_groupes, got " + Str(juncCount))
      End 1
    EndIf
  EndIf
  FinishDatabaseQuery(*db\GetHandle())
EndIf

; 6. Nettoyage
FreeStructure(*contact)
FreeStructure(*t1)
FreeStructure(*t2)
FreeStructure(*g1)
*db\Disconnect()

PrintN("=================================================================")
PrintN("  ALL TESTS PASSED SUCCESSFULLY! (100% OK)")
PrintN("=================================================================")
