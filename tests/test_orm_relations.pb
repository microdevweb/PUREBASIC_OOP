Procedure.i New_Contact()
  Protected *obj.Contact_Inst = AllocateStructure(Contact_Inst)
  If *obj
    *obj\VTable = ?Contact_VTable_Data
    *obj\orm_isNew = #True
    *obj\orm_isDirty = #False
    *obj\telephones = EntitySet::New()
    *obj\groupes = EntitySet::New()
  EndIf
  ProcedureReturn *obj
EndProcedure

Procedure Free_Contact(*obj.Contact_Inst)
  If *obj
    If *obj\telephones : *obj\telephones\Free() : EndIf
    If *obj\groupes : *obj\groupes\Free() : EndIf
    FreeStructure(*obj)
  EndIf
EndProcedure

