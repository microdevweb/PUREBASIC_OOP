Procedure Contact_Serialize(*This.Contact_Inst, Map values.s())
  ClearMap(values())
  values("firstName") = *This\firstName
  values("lastName") = *This\lastName
  values("email") = *This\email
  values("isPrimary") = Str(*This\isPrimary)
  values("client_id") = Str(*This\client_id)
EndProcedure

Procedure Contact_Deserialize(*This.Contact_Inst, Map values.s())
  If FindMapElement(values(), "id") : *This\id = Val(values()) : EndIf
  If FindMapElement(values(), "firstName") : *This\firstName = values() : EndIf
  If FindMapElement(values(), "lastName") : *This\lastName = values() : EndIf
  If FindMapElement(values(), "email") : *This\email = values() : EndIf
  If FindMapElement(values(), "isPrimary") : *This\isPrimary = Val(values()) : EndIf
  If FindMapElement(values(), "client_id") : *This\client_id = Val(values()) : EndIf
EndProcedure

Procedure Client_Serialize(*This.Client_Inst, Map values.s())
  ClearMap(values())
  values("companyName") = *This\companyName
  values("email") = *This\email
  values("phone") = *This\phone
  values("city") = *This\city
  values("isActive") = Str(*This\isActive)
EndProcedure

Procedure Client_Deserialize(*This.Client_Inst, Map values.s())
  If FindMapElement(values(), "id") : *This\id = Val(values()) : EndIf
  If FindMapElement(values(), "companyName") : *This\companyName = values() : EndIf
  If FindMapElement(values(), "email") : *This\email = values() : EndIf
  If FindMapElement(values(), "phone") : *This\phone = values() : EndIf
  If FindMapElement(values(), "city") : *This\city = values() : EndIf
  If FindMapElement(values(), "isActive") : *This\isActive = Val(values()) : EndIf
EndProcedure

Procedure Client_SaveChildren_contacts(*This.Client_Inst, db.i)
  Protected targetDb.DatabaseEngine::IDatabase = Database::WrapHandle(db)
  If Not targetDb : targetDb = Database::GetDefault() : EndIf
  If Not targetDb : ProcedureReturn : EndIf
  If *This\contacts
    Protected count.i = *This\contacts\Count()
    Protected i.i
    For i = 0 To count - 1
      Protected item.DatabaseEntities::IDatabaseEntity = *This\contacts\Get(i)
      If item
        Protected *itemInst.Contact_Inst = item
        *itemInst\client_id = *This\id
        item\Save(targetDb)
      EndIf
    Next
    count = *This\contacts\GetRemovedCount()
    For i = 0 To count - 1
      Protected remItem.DatabaseEntities::IDatabaseEntity = *This\contacts\GetRemovedItem(i)
      If remItem : remItem\Delete(targetDb) : EndIf
    Next
    *This\contacts\ResetTracking()
  EndIf
EndProcedure

Procedure Register_All_Entities()
  NewList currentFields.ORM_Schema::ORM_FieldDef()
  NewList currentRelations.ORM_Schema::ORM_RelationDef()

  ; Register entity Contact
  ClearList(currentFields())
  ClearList(currentRelations())
  AddElement(currentFields()) : currentFields()\name = "firstName" : currentFields()\typeCode = ORM_Entity::#ORM_Type_String
  AddElement(currentFields()) : currentFields()\name = "lastName" : currentFields()\typeCode = ORM_Entity::#ORM_Type_String
  AddElement(currentFields()) : currentFields()\name = "email" : currentFields()\typeCode = ORM_Entity::#ORM_Type_String
  AddElement(currentFields()) : currentFields()\name = "isPrimary" : currentFields()\typeCode = ORM_Entity::#ORM_Type_Bool
  AddElement(currentFields()) : currentFields()\name = "client_id" : currentFields()\typeCode = ORM_Entity::#ORM_Type_Integer
  ORM_Schema::RegisterEntity("Contact", "contacts", currentFields(), currentRelations(), @Contact_Serialize(), @Contact_Deserialize(), @New_Contact(), #True)

  ; Register entity Client
  ClearList(currentFields())
  ClearList(currentRelations())
  AddElement(currentFields()) : currentFields()\name = "companyName" : currentFields()\typeCode = ORM_Entity::#ORM_Type_String
  AddElement(currentFields()) : currentFields()\name = "email" : currentFields()\typeCode = ORM_Entity::#ORM_Type_String
  AddElement(currentFields()) : currentFields()\name = "phone" : currentFields()\typeCode = ORM_Entity::#ORM_Type_String
  AddElement(currentFields()) : currentFields()\name = "city" : currentFields()\typeCode = ORM_Entity::#ORM_Type_String
  AddElement(currentFields()) : currentFields()\name = "isActive" : currentFields()\typeCode = ORM_Entity::#ORM_Type_Bool
  AddElement(currentRelations())
  currentRelations()\relationType = ORM_Entity::#ORM_Rel_OneToMany
  currentRelations()\propertyName = "contacts"
  currentRelations()\childEntityType = "Contact"
  currentRelations()\childTable = "contacts"
  currentRelations()\fkColumn = "client_id"
  currentRelations()\joinTable = ""
  currentRelations()\parentFkColumn = "client_id"
  currentRelations()\childFkColumn = "contact_id"
  currentRelations()\cascadeSave = #True
  currentRelations()\saveChildrenProc = @Client_SaveChildren_contacts()
  ORM_Schema::RegisterEntity("Client", "clients", currentFields(), currentRelations(), @Client_Serialize(), @Client_Deserialize(), @New_Client(), #True)

EndProcedure

; ----------------------------------------------------------------------------
; 6. MAIN PROGRAM EXECUTION
; ----------------------------------------------------------------------------

Register_All_Entities()

; =============================================================================
; 06_database_crm / main.pbo
; PureBasic OOP Framework - Alpha 1.4 - Modern ORM Entity Demo
; =============================================================================
; Demonstrates PureBasic OOP Phase 2 modern entity architecture:
;   - Native entity classes implementing IDatabaseEntity
;   - Declaring 1-N relation: HasMany contacts.Contact_vt
;   - Zero manual boilerplate: Auto-generated serialization, schemas, methods
;   - Active Record saving: *client\Save() or *client\Save(*db)
;   - Cascade save: saving client automatically cascades and saves contacts
;   - AutoMigrate creates all SQLite tables and relations
; =============================================================================

; -----------------------------------------------------------------------------
; 1. ENTITY DEFINITIONS
; -----------------------------------------------------------------------------



; -----------------------------------------------------------------------------
; 2. APPLICATION EXECUTION
; -----------------------------------------------------------------------------

OpenConsole()
PrintN("=================================================================")
PrintN("   PureBasic OOP - 06 Database CRM Demo (Modern ORM Engine)")
PrintN("=================================================================")

; Database initialization
DeleteFile(#DB_FILE)

Define *db.DatabaseEngine::IDatabase = Database::NewSQLite(#DB_FILE)
If Not *db
  PrintN("[ERROR] Failed to open database: " + #DB_FILE)
  End 1
EndIf

; Set default database connection for Active Record style operations
Database::SetDefault(*db)

; Auto-migration generates schema directly from class declarations
If Not *db\AutoMigrate()
  PrintN("[ERROR] Schema AutoMigrate failed!")
  End 1
EndIf
PrintN("[SUCCESS] Database tables (clients, contacts) created automatically.")

; -----------------------------------------------------------------------------
; 3. CREATING AND PERSISTING ENTITY WITH RELATIONS
; -----------------------------------------------------------------------------

PrintN("")
PrintN("Creating Client 'Acme Corp' with 2 contacts...")

Define *client.Client_vt = New_Client()
*client\Set_companyName("Acme Corporation")
*client\Set_email("contact@acme.corp")
*client\Set_phone("+33 1 23 45 67 89")
*client\Set_city("Paris")
*client\Set_isActive(#True)

; Contact 1
Define *c1.Contact_vt = New_Contact()
*c1\Set_firstName("Jean")
*c1\Set_lastName("Dupont")
*c1\Set_email("j.dupont@acme.corp")
*c1\Set_isPrimary(#True)
*client\Add_contacts(*c1)

; Contact 2
Define *c2.Contact_vt = New_Contact()
*c2\Set_firstName("Sophie")
*c2\Set_lastName("Martin")
*c2\Set_email("s.martin@acme.corp")
*c2\Set_isPrimary(#False)
*client\Add_contacts(*c2)

; Active Record style save: *client\Save()
; Automatically inserts Client into 'clients', generates ID,
; and cascades to save *c1 and *c2 into 'contacts' with foreign key client_id.
If *client\Save()
  PrintN("[SUCCESS] Client saved with ID: " + Str(*client\GetId()))
  PrintN("[SUCCESS] Contact 1 saved with ID: " + Str(*c1\GetId()))
  PrintN("[SUCCESS] Contact 2 saved with ID: " + Str(*c2\GetId()))
Else
  PrintN("[ERROR] Failed to save Client!")
EndIf

; -----------------------------------------------------------------------------
; 4. DIRECT DATABASE VERIFICATION
; -----------------------------------------------------------------------------

PrintN("")
PrintN("Verifying data directly in SQLite...")

Define query.i = *db\Query("SELECT id, companyName, city FROM clients WHERE id = " + Str(*client\GetId()) + ";")
If query
  If NextDatabaseRow(*db\GetHandle())
    PrintN("  Client row found: ID=" + Str(GetDatabaseLong(*db\GetHandle(), 0)) + ", Name=" + GetDatabaseString(*db\GetHandle(), 1) + ", City=" + GetDatabaseString(*db\GetHandle(), 2))
  EndIf
  FinishDatabaseQuery(*db\GetHandle())
EndIf

query = *db\Query("SELECT id, firstName, lastName, client_id FROM contacts WHERE client_id = " + Str(*client\GetId()) + ";")
If query
  While NextDatabaseRow(*db\GetHandle())
    PrintN("  Contact row found: ID=" + Str(GetDatabaseLong(*db\GetHandle(), 0)) + " -> " + GetDatabaseString(*db\GetHandle(), 1) + " " + GetDatabaseString(*db\GetHandle(), 2) + " (client_id=" + Str(GetDatabaseLong(*db\GetHandle(), 3)) + ")")
  Wend
  FinishDatabaseQuery(*db\GetHandle())
EndIf

; -----------------------------------------------------------------------------
; 5. CLEANUP
; -----------------------------------------------------------------------------

FreeStructure(*client)
FreeStructure(*c1)
FreeStructure(*c2)
*db\Disconnect()

PrintN("")
PrintN("=================================================================")
PrintN("   Demo completed successfully! Press Enter to exit.")
PrintN("=================================================================")
CloseConsole()
