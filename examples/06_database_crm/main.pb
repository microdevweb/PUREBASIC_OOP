Procedure.i New_Contact()
  Protected *obj.Contact_Inst = AllocateStructure(Contact_Inst)
  If *obj
    *obj\VTable = ?Contact_VTable_Data
    *obj\orm_isNew = #True
    *obj\orm_isDirty = #False
  EndIf
  ProcedureReturn *obj
EndProcedure

Procedure Free_Contact(*obj.Contact_Inst)
  If *obj
    FreeStructure(*obj)
  EndIf
EndProcedure

Procedure.i New_Client()
  Protected *obj.Client_Inst = AllocateStructure(Client_Inst)
  If *obj
    *obj\VTable = ?Client_VTable_Data
    *obj\orm_isNew = #True
    *obj\orm_isDirty = #False
    *obj\contacts = EntitySet::New()
  EndIf
  ProcedureReturn *obj
EndProcedure

Procedure Free_Client(*obj.Client_Inst)
  If *obj
    If *obj\contacts : *obj\contacts\Free() : EndIf
    FreeStructure(*obj)
  EndIf
EndProcedure

